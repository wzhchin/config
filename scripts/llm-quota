#!/usr/bin/env python3
"""
llm-limits — print AI coding-provider usage / quota / balance to the terminal.

Stdlib-only (uses urllib). The provider logic is lifted from CodexBar
(https://github.com/steipete/CodexBar, Swift) and re-implemented here. Four
providers:

  glm      — z.ai / 智谱 coding-plan token quota windows (TOKENS_LIMIT / TIME_LIMIT)
  deepseek — DeepSeek balance + this month's token/cost usage
  codex    — OpenAI Codex OAuth usage windows (read from ~/.codex/auth.json)
  grok     — xAI Grok Build credit usage (read from ~/.grok/auth.json)
  all      — print all four at once (also the default when no provider is given)

Usage:
  GLM_API_KEY=...        llm_limits.py glm
  DEEPSEEK_API_KEY=...    llm_limits.py deepseek
  llm_limits.py codex
  llm_limits.py grok
  llm_limits.py all                       # prints glm + deepseek + codex + grok
  llm_limits.py                           # same as 'all'

Credentials are read from the environment first, then from
``pass-sliver get NAME`` when the environment variable is missing:
  GLM_API_KEY        GLM / z.ai token
  DEEPSEEK_API_KEY    DeepSeek platform API key
  DEEPSEEK_SESSION_KEY
                      DeepSeek web-session token (optional, for usage details)
  GLM_REGION          cn (default, open.bigmodel.cn) | global (api.z.ai)
  GLM_API_HOST       override z.ai base host
  CODEX_HOME          override ~/.codex location
  GROK_HOME           override ~/.grok location
  NO_COLOR            set to disable colors
"""

from __future__ import annotations

import argparse
import concurrent.futures
import datetime as _dt
import io
import json
import math
import os
import struct
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request


# --------------------------------------------------------------------------- #
# color helpers
# --------------------------------------------------------------------------- #

_USE_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def _c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if _USE_COLOR else text


def C_BOLD(text: str) -> str:  # noqa: N802
    return _c("1", text)


def C_DIM(text: str) -> str:  # noqa: N802
    return _c("2", text)


def C_RED(text: str) -> str:  # noqa: N802
    return _c("31", text)


def C_GREEN(text: str) -> str:  # noqa: N802
    return _c("32", text)


def C_YELLOW(text: str) -> str:  # noqa: N802
    return _c("33", text)


def C_CYAN(text: str) -> str:  # noqa: N802
    return _c("36", text)


def C_MAGENTA(text: str) -> str:  # noqa: N802
    return _c("35", text)


def _severity_color(pct) -> str:
    """ANSI color code for a usage percentage (higher = worse)."""
    if pct is None:
        return "2"
    try:
        n = float(pct)
    except (TypeError, ValueError):
        return "2"
    if n >= 90:
        return "31"       # red
    if n >= 70:
        return "33"       # yellow
    if n >= 40:
        return "36"       # cyan
    return "32"           # green


def color_pct(pct) -> str:
    """Color a percentage 0-100 by severity."""
    if pct is None:
        return C_DIM("—")
    try:
        n = float(pct)
    except (TypeError, ValueError):
        return C_DIM("—")
    # Keep one decimal only when needed; right-align for columns.
    if abs(n - round(n)) < 0.05:
        s = f"{int(round(n)):>3}%"
    else:
        s = f"{n:>4.1f}%"
    return _c(_severity_color(n), s)


def die(msg: str) -> "typing.NoReturn":
    print(C_RED("error:") + f" {msg}", file=sys.stderr)
    sys.exit(1)


class ProviderError(Exception):
    """Raised by a provider when it cannot produce a result (API error, network, etc.)."""


class _Skip(Exception):
    """Raised when a provider has no credentials configured — print nothing, just skip."""


def _credential(name: str) -> str:
    """Read a credential from the environment, then fall back to pass-sliver."""
    value = (os.environ.get(name) or "").strip()
    if value:
        return value

    try:
        result = subprocess.run(
            ["pass-sliver", "get", name],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
        )
    except OSError:
        return ""

    if result.returncode != 0:
        return ""
    return result.stdout.strip()


# --------------------------------------------------------------------------- #
# formatting
# --------------------------------------------------------------------------- #

# Column widths for aligned usage rows across providers.
_LABEL_W = 10
_BAR_W = 16


def header(name: str, *meta: str) -> None:
    """Provider title:  ● Name  ·  meta1  ·  meta2"""
    parts = [C_BOLD(name)]
    clean = [m for m in meta if m]
    if clean:
        parts.append(C_DIM("·"))
        parts.append(C_DIM(" · ".join(clean)))
    print(f"{C_CYAN('●')} {' '.join(parts)}")


def kv(key: str, value: str) -> None:
    """Plain info row (balance, notes, non-usage facts)."""
    print(f"  {C_DIM(f'{key:<{_LABEL_W}}')}  {value}")


def note(text: str) -> None:
    """Dim one-liner under a header (errors, empty states)."""
    print(f"  {C_DIM(text)}")


def usage_row(label: str, pct, *, reset=None, reset_ms=None, hint: str | None = None) -> None:
    """Aligned usage meter:

        session   ████░░░░░░░░░░░░   12%  6d 4h
    """
    bar_s = bar(pct, width=_BAR_W)
    pct_s = color_pct(pct)

    rel = None
    if reset_ms is not None:
        rel = fmt_reset_rel_ms(reset_ms)
    elif reset is not None:
        rel = fmt_reset_rel_s(reset)

    # Tail: remaining time first; optional window/period hint joined with ·
    if rel and hint:
        tail = f"  {C_DIM(rel)} {C_DIM('·')} {C_DIM(hint)}"
    elif rel:
        tail = f"  {C_DIM(rel)}"
    elif hint:
        tail = f"  {C_DIM(hint)}"
    else:
        tail = ""

    print(f"  {label:<{_LABEL_W}}  {bar_s}  {pct_s}{tail}")


def fmt_int(n) -> str:
    try:
        n = int(float(n))
    except (TypeError, ValueError):
        n = 0
    sign = "-" if n < 0 else ""
    n = abs(n)
    return sign + f"{n:,}"


def bar(pct, width: int = _BAR_W) -> str:
    """Colored partial bar: filled segment by severity, empty dim."""
    try:
        p = float(pct)
    except (TypeError, ValueError):
        p = 0.0
    p = max(0.0, min(100.0, p))
    filled = round(p / 100 * width)
    filled = max(0, min(width, filled))
    # Use a full block for filled, light shade for empty — reads cleanly in most fonts.
    head = "█" * filled
    tail = "░" * (width - filled)
    if not _USE_COLOR:
        return head + tail
    return _c(_severity_color(p), head) + _c("2", tail)


def fmt_reset_ms(ms) -> str:
    """Legacy absolute+relative form (kept for callers that still want it)."""
    if ms in (None, 0):
        return "—"
    try:
        secs = int(ms) / 1000
    except (TypeError, ValueError):
        return "—"
    return _fmt_reset(secs)


def fmt_reset_s(s) -> str:
    if s in (None, 0):
        return "—"
    try:
        secs = int(s)
    except (TypeError, ValueError):
        return "—"
    return _fmt_reset(secs)


def fmt_reset_rel_ms(ms) -> str | None:
    if ms in (None, 0):
        return None
    try:
        return _fmt_rel(int(ms) / 1000)
    except (TypeError, ValueError):
        return None


def fmt_reset_rel_s(s) -> str | None:
    if s in (None, 0):
        return None
    try:
        return _fmt_rel(float(s))
    except (TypeError, ValueError):
        return None


def _fmt_rel(epoch_secs: float) -> str:
    """Compact remaining time: 'now' | '12m' | '2h 5m' | '6d 4h'."""
    diff = epoch_secs - time.time()
    if diff <= 0:
        return "now"
    d = int(diff // 86400)
    h = int((diff % 86400) // 3600)
    m = int((diff % 3600) // 60)
    if d:
        return f"{d}d {h}h" if h else f"{d}d"
    if h:
        return f"{h}h {m}m" if m else f"{h}h"
    return f"{m}m"


def _fmt_reset(epoch_secs: float) -> str:
    now = time.time()
    diff = epoch_secs - now
    when = _dt.datetime.fromtimestamp(epoch_secs).strftime("%Y-%m-%d %H:%M").strip()
    if diff <= 0:
        return f"{when} (now)"
    return f"{when} (in {_fmt_rel(epoch_secs)})"


def _window_label(seconds) -> str | None:
    """Human label for a rate-limit window length in seconds."""
    try:
        s = int(seconds)
    except (TypeError, ValueError):
        return None
    if s <= 0:
        return None
    # Common fixed windows.
    known = {
        300: "5m",
        900: "15m",
        1800: "30m",
        3600: "1h",
        10800: "3h",
        18000: "5h",
        86400: "1d",
        604800: "7d",
        10080: "7d",   # some APIs send minutes-of-week as seconds by mistake
    }
    if s in known:
        return known[s]
    if s % 86400 == 0:
        days = s // 86400
        return f"{days}d"
    if s % 3600 == 0:
        hours = s // 3600
        return f"{hours}h"
    if s % 60 == 0:
        mins = s // 60
        return f"{mins}m"
    return f"{s}s"


# --------------------------------------------------------------------------- #
# HTTP
# --------------------------------------------------------------------------- #


def http_get_json(url: str, bearer: str = "", headers: dict | None = None,
                  timeout: int = 20) -> tuple[int, dict | bytes]:
    """GET url; return (status, parsed-json-or-raw-bytes)."""
    req_headers = {"Accept": "application/json"}
    if bearer:
        req_headers["Authorization"] = f"Bearer {bearer}"
    if headers:
        req_headers.update(headers)
    req = urllib.request.Request(url, headers=req_headers, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = resp.read()
            status = resp.status
    except urllib.error.HTTPError as e:
        data = e.read()
        status = e.code
    try:
        return status, json.loads(data.decode("utf-8", "replace"))
    except (ValueError, UnicodeDecodeError):
        return status, data


def http_get_raw(url: str, bearer: str = "", headers: dict | None = None,
                 timeout: int = 20) -> tuple[int, bytes]:
    req_headers = {"Accept": "application/json"}
    if bearer:
        req_headers["Authorization"] = f"Bearer {bearer}"
    if headers:
        req_headers.update(headers)
    req = urllib.request.Request(url, headers=req_headers, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, resp.read()
    except urllib.error.HTTPError as e:
        return e.code, e.read()


def http_post_raw(url: str, body: bytes = b"", headers: dict | None = None,
                  timeout: int = 20) -> tuple[int, bytes, dict]:
    """POST body; return (status, raw-bytes, response-headers-dict)."""
    req_headers = dict(headers or {})
    req = urllib.request.Request(url, data=body, headers=req_headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, resp.read(), dict(resp.headers)
    except urllib.error.HTTPError as e:
        return e.code, e.read(), dict(e.headers)


# --------------------------------------------------------------------------- #
# GLM / z.ai  (智谱)
# --------------------------------------------------------------------------- #

_ZAI_UNIT = {1: "minute", 3: "hour", 5: "day", 6: "week"}

# window length in minutes per z.ai unit (mirrors CodexBar ZaiLimitUnit)
_ZAI_UNIT_MINUTES = {1: 1, 3: 60, 5: 1440, 6: 10080}


def _glm_unit_label(unit) -> str | None:
    try:
        return _ZAI_UNIT[int(unit)]
    except (TypeError, ValueError, KeyError):
        return None


def _glm_window_minutes(entry: dict) -> int | None:
    number = entry.get("number") or 0
    if number <= 0:
        return None
    try:
        unit = int(entry.get("unit", 0))
    except (TypeError, ValueError):
        return None
    per_unit = _ZAI_UNIT_MINUTES.get(unit)
    return None if per_unit is None else per_unit * number


def _glm_used_pct(entry: dict):
    """Mirrors CodexBar ZaiLimitEntry.computedUsedPercent / usedPercent."""
    limit = entry.get("usage")
    if isinstance(limit, (int, float)) and limit > 0:
        remaining = entry.get("remaining")
        current = entry.get("currentValue")
        used = None
        if isinstance(remaining, (int, float)):
            from_rem = limit - remaining
            used = max(from_rem, current) if isinstance(current, (int, float)) else from_rem
        elif isinstance(current, (int, float)):
            used = current
        if used is not None:
            used = max(0, min(limit, used))
            return round(used / limit * 100, 1)
    pct = entry.get("percentage")
    return float(pct) if isinstance(pct, (int, float)) else 0.0


def _glm_window_desc(entry: dict) -> str | None:
    number = entry.get("number") or 0
    if number <= 0:
        return None
    unit_word = _glm_unit_label(entry.get("unit"))
    if not unit_word:
        return None
    suffix = unit_word if number == 1 else f"{unit_word}s"
    return f"{number} {suffix}"


def _glm_print_limit(label: str, entry: dict) -> None:
    pct = _glm_used_pct(entry)
    win = _glm_window_desc(entry)
    reset = entry.get("nextResetTime")
    usage_row(label, pct, reset_ms=reset, hint=win)


def do_glm() -> int:
    api_key = _credential("GLM_API_KEY")
    # Default to the mainland-China endpoint (open.bigmodel.cn). Set
    # GLM_REGION=global for the international api.z.ai endpoint.
    region = os.environ.get("GLM_REGION") or "cn"

    host_override = (os.environ.get("GLM_API_HOST") or "").strip()
    if host_override:
        host = host_override.rstrip("/")
        if not host.startswith("http"):
            host = "https://" + host
    elif region in ("global", "zai"):
        host = "https://api.z.ai"
    else:
        host = "https://open.bigmodel.cn"
    url = f"{host}/api/monitor/usage/quota/limit"

    if not api_key:
        raise _Skip()

    status, body = http_get_json(url, bearer=api_key)
    if status != 200 or not isinstance(body, dict):
        raise ProviderError(f"request failed (HTTP {status}): "
                            f"{body if not isinstance(body, dict) else body.get('msg', '')}")
    if not (body.get("success") is True and body.get("code") == 200):
        raise ProviderError(f"API error: {body.get('msg', 'code ' + str(body.get('code')))}.")
    data = body.get("data") or {}
    limits = data.get("limits") or []

    plan = next((data.get(k) for k in ("planName", "plan", "plan_type", "packageName")
                 if data.get(k)), None)
    plan = plan.strip() if isinstance(plan, str) else None
    host_short = host.removeprefix("https://").removeprefix("http://")

    header("GLM", plan, host_short)

    token_limits = [e for e in limits if e.get("type") == "TOKENS_LIMIT"]
    time_limits = [e for e in limits if e.get("type") == "TIME_LIMIT"]

    if token_limits:
        # shortest window first (session), longest last (quota)
        token_limits.sort(key=lambda e: _glm_window_minutes(e) or float("inf"))
        _glm_print_limit("session", token_limits[0])
        if len(token_limits) >= 2:
            _glm_print_limit("quota", token_limits[-1])

    for entry in time_limits:
        # MCP monthly marker is a 1-minute sentinel; label all TIME_LIMIT as monthly.
        _glm_print_limit("monthly", entry)

    if not token_limits and not time_limits:
        note("no rate-limit entries returned")
    return 0


# --------------------------------------------------------------------------- #
# DeepSeek
# --------------------------------------------------------------------------- #


def _sum_amounts(node, key_path=()) -> float:
    """Sum numeric `amount` fields under total[].usage[] trees (best-effort)."""
    total = 0.0

    def walk(n):
        nonlocal total
        if isinstance(n, dict):
            if isinstance(n.get("amount"), (int, float, str)):
                try:
                    total += float(n["amount"])
                except (TypeError, ValueError):
                    pass
            for v in n.values():
                walk(v)
        elif isinstance(n, list):
            for v in n:
                walk(v)

    walk(node)
    return total


def _deepseek_sum_totals(payload, *, only_type=None, daily_date=None) -> float:
    """Sum amount values inside .data.biz_data[].total[] (or .days[] when daily_date)."""
    total = 0.0
    data = (payload or {}).get("data", {}) if isinstance(payload, dict) else {}
    biz_list = data.get("biz_data") or []
    if not isinstance(biz_list, list):
        biz_list = [biz_list]
    for biz in biz_list:
        if not isinstance(biz, dict):
            continue
        if daily_date is not None:
            days = biz.get("days") or []
            for day in days:
                if isinstance(day, dict) and day.get("date") == daily_date:
                    total += _sum_usage(day.get("data"), only_type=only_type)
        else:
            total += _sum_usage(biz.get("total"), only_type=only_type)
    return total


def _sum_usage(node, *, only_type=None) -> float:
    """node is a list of {model, usage:[{type, amount}]}; sum amounts."""
    total = 0.0
    if not isinstance(node, list):
        return total
    for model in node:
        if not isinstance(model, dict):
            continue
        for item in model.get("usage") or []:
            if not isinstance(item, dict):
                continue
            if only_type and (item.get("type") or "").upper() != only_type:
                continue
            amt = item.get("amount")
            if isinstance(amt, (int, float, str)):
                try:
                    total += float(amt)
                except (TypeError, ValueError):
                    pass
    return total


def do_deepseek() -> int:
    api_key = _credential("DEEPSEEK_API_KEY")
    session_key = _credential("DEEPSEEK_SESSION_KEY")
    if not api_key:
        raise _Skip()

    # --- balance ---
    status, body = http_get_json("https://api.deepseek.com/user/balance", bearer=api_key)
    if status != 200 or not isinstance(body, dict):
        raise ProviderError(f"balance request failed (HTTP {status}).")

    infos = body.get("balance_infos") or []
    avail = body.get("is_available")
    bal_meta = None
    bal_detail = None
    if infos:
        info = infos[0]
        currency = info.get("currency", "USD")
        sym = "¥" if currency == "CNY" else "$"
        try:
            total = float(info.get("total_balance", 0))
            granted = float(info.get("granted_balance", 0))
            topped = float(info.get("topped_up_balance", 0))
        except (TypeError, ValueError):
            total = granted = topped = 0.0
        if total <= 0:
            bal_meta = f"{sym}0.00"
            bal_detail = "add credits at platform.deepseek.com"
        elif avail is not True:
            bal_meta = "unavailable"
            bal_detail = "balance not available for API calls"
        else:
            bal_meta = f"{sym}{total:.2f}"
            bal_detail = f"paid {sym}{topped:.2f} · granted {sym}{granted:.2f}"
    else:
        bal_meta = "—"

    header("DeepSeek")
    if bal_detail:
        kv("detail", bal_detail)

    # --- monthly usage (amount + cost) ---
    now = _dt.datetime.now(_dt.timezone.utc)
    month, year = now.month, now.year
    today = now.strftime("%Y-%m-%d")

    amount_url = (f"https://platform.deepseek.com/api/v0/usage/amount"
                  f"?month={month}&year={year}")
    cost_url = (f"https://platform.deepseek.com/api/v0/usage/cost"
                f"?month={month}&year={year}")

    extra_headers = {
        "User-Agent": (
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:152.0) "
            "Gecko/20100101 Firefox/152.0"
        )
    }
    amt_status, amt = http_get_json(amount_url, bearer=session_key, headers=extra_headers)
    cost_status, cost = http_get_json(cost_url, bearer=session_key, headers=extra_headers)

    if amt_status != 200 or not isinstance(amt, dict):
        note(f"usage unavailable (HTTP {amt_status})")
        return 0

    month_tokens = _deepseek_sum_totals(amt)
    month_tokens_int = int(month_tokens)
    month_cost = _deepseek_sum_totals(cost) if isinstance(cost, dict) else 0.0
    month_req = int(_deepseek_sum_totals(amt, only_type="REQUEST"))
    cost_currency = "CNY"
    if isinstance(cost, dict):
        biz = (cost.get("data") or {}).get("biz_data") or []
        if biz and isinstance(biz[0], dict):
            cost_currency = biz[0].get("currency", "CNY")
    csym = "¥" if cost_currency == "CNY" else "$"

    today_tokens = _deepseek_sum_totals(amt, daily_date=today)
    today_cost = _deepseek_sum_totals(cost, daily_date=today) if isinstance(cost, dict) else 0.0

    if month_tokens_int > 0:
        req_part = f" · {fmt_int(month_req)} req" if month_req else ""
        kv("month", f"{fmt_int(month_tokens_int)} tok · {csym}{month_cost:.2f}{req_part}")
    if int(today_tokens) > 0:
        kv("today", f"{fmt_int(int(today_tokens))} tok · {csym}{today_cost:.2f}")
    return 0


# --------------------------------------------------------------------------- #
# Codex (OAuth)
# --------------------------------------------------------------------------- #


def _codex_home() -> str:
    home = (os.environ.get("CODEX_HOME") or "").strip()
    return home if home else os.path.join(os.path.expanduser("~"), ".codex")


def _codex_base_url() -> str:
    """Resolve ChatGPT base URL, honoring ~/.codex/config.toml chatgpt_base_url."""
    default = "https://chatgpt.com/backend-api"
    cfg = os.path.join(_codex_home(), "config.toml")
    custom = None
    if os.path.isfile(cfg):
        try:
            with open(cfg, "r", encoding="utf-8") as f:
                for raw in f:
                    line = raw.split("#", 1)[0].strip()
                    if not line or "=" not in line:
                        continue
                    key, _, val = line.partition("=")
                    if key.strip() == "chatgpt_base_url":
                        v = val.strip().strip('"').strip("'").strip()
                        if v:
                            custom = v
                        break
        except OSError:
            pass
    if not custom:
        return default
    base = custom.rstrip("/")
    if (base.startswith("https://chatgpt.com") or base.startswith("https://chat.openai.com")) \
            and "backend-api" not in base:
        base += "/backend-api"
    return base


def _codex_print_window(label: str, window: dict) -> None:
    pct = window.get("used_percent")
    reset = window.get("reset_at")
    win = _window_label(window.get("limit_window_seconds"))
    # Promote generic "primary" to a readable window label when we can.
    if label == "primary" and win:
        if win in ("5m", "15m", "30m", "1h", "3h", "5h"):
            label = "session"
        elif win in ("1d", "7d"):
            label = "weekly" if win == "7d" else "daily"
        else:
            label = win
    # Remaining time is enough when present; only show window size as a hint
    # when the API omitted a reset timestamp.
    usage_row(label, pct, reset=reset, hint=None if reset else win)


def do_codex() -> int:
    auth_file = os.path.join(_codex_home(), "auth.json")
    if not os.path.isfile(auth_file):
        raise _Skip()
    try:
        with open(auth_file, "r", encoding="utf-8") as f:
            auth = json.load(f)
    except (OSError, ValueError) as e:
        raise ProviderError(f"failed to read auth.json: {e}")

    tokens = auth.get("tokens") or {}
    access = (auth.get("OPENAI_API_KEY")
              or tokens.get("access_token")
              or tokens.get("accessToken"))
    if not access:
        raise ProviderError(f"no access token in {auth_file} (re-run 'codex login').")
    account = tokens.get("account_id") or tokens.get("accountId")

    base = _codex_base_url()
    path = "/wham/usage" if "backend-api" in base else "/api/codex/usage"
    url = base + path

    headers = {}
    if account:
        headers["ChatGPT-Account-Id"] = account

    status, body = http_get_json(url, bearer=access, headers=headers)
    if status == 401 or status == 403:
        raise ProviderError("token expired or invalid (run 'codex login').")
    if status != 200 or not isinstance(body, dict):
        detail = body if not isinstance(body, dict) else ""
        raise ProviderError(f"usage request failed (HTTP {status}) {detail}".rstrip())

    plan = body.get("plan_type")
    meta = []
    if plan:
        meta.append(str(plan))

    credits = body.get("credits") or {}
    if credits.get("unlimited"):
        meta.append("credits ∞")
    elif credits.get("balance") is not None:
        meta.append(f"credits {credits['balance']}")
    elif credits.get("has_credits"):
        meta.append("credits available")

    header("Codex", *meta)

    rate_limit = body.get("rate_limit") or {}
    primary = rate_limit.get("primary_window")
    secondary = rate_limit.get("secondary_window")
    if primary:
        _codex_print_window("primary", primary)
    if secondary:
        _codex_print_window("weekly", secondary)

    extras = body.get("additional_rate_limits") or []
    for extra in extras:
        if not isinstance(extra, dict):
            continue
        name = extra.get("limit_name") or extra.get("metered_feature") or "extra"
        # Keep extra labels short for the fixed column.
        if isinstance(name, str) and len(name) > _LABEL_W:
            name = name[:_LABEL_W - 1] + "…"
        rl = (extra.get("rate_limit") or {}).get("primary_window")
        if rl:
            _codex_print_window(name, rl)

    if not primary and not secondary and not extras:
        note("no rate-limit windows in response")
    return 0


# --------------------------------------------------------------------------- #
# Grok (xAI Grok Build) — credits via grok.com gRPC-web billing
# --------------------------------------------------------------------------- #
#
# Mirrors CodexBar's Grok provider (docs/grok.md):
#   1. Identity from ~/.grok/auth.json (written by `grok login`)
#   2. Credit usage from POST GetGrokCreditsConfig (gRPC-web protobuf)
# CLI `grok agent stdio` + `x.ai/billing` is currently Method-not-found on the
# agent surface, so web billing is the reliable path.

_GROK_OIDC_PREFIX = "https://auth.x.ai::"
_GROK_LEGACY_SCOPE = "https://accounts.x.ai/sign-in"
_GROK_BILLING_URL = (
    "https://grok.com/grok_api_v2.GrokBuildBilling/GetGrokCreditsConfig"
)


def _grok_home() -> str:
    home = (os.environ.get("GROK_HOME") or "").strip()
    return home if home else os.path.join(os.path.expanduser("~"), ".grok")


def _grok_parse_iso(raw: str | None):
    if not raw or not isinstance(raw, str):
        return None
    s = raw.strip()
    if not s:
        return None
    # Support fractional seconds; datetime.fromisoformat handles "Z" on 3.11+.
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    try:
        return _dt.datetime.fromisoformat(s)
    except ValueError:
        # Truncate sub-microsecond fractions if present.
        if "." in s:
            head, rest = s.split(".", 1)
            frac = ""
            tz = ""
            for i, ch in enumerate(rest):
                if ch.isdigit():
                    frac += ch
                else:
                    tz = rest[i:]
                    break
            try:
                return _dt.datetime.fromisoformat(f"{head}.{frac[:6]}{tz}")
            except ValueError:
                return None
        return None


def _grok_load_credentials() -> dict:
    """Load preferred entry from ~/.grok/auth.json.

    Returns a dict with access_token, email, team_id, auth_mode, expires_at, …
    Raises _Skip if the file is missing; ProviderError on corrupt/empty auth.
    """
    auth_file = os.path.join(_grok_home(), "auth.json")
    if not os.path.isfile(auth_file):
        raise _Skip()
    try:
        with open(auth_file, "r", encoding="utf-8") as f:
            root = json.load(f)
    except (OSError, ValueError) as e:
        raise ProviderError(f"failed to read auth.json: {e}")
    if not isinstance(root, dict):
        raise ProviderError(f"invalid auth.json in {_grok_home()} (expected object).")

    oidc = None
    legacy = None
    for scope, entry in root.items():
        if not isinstance(entry, dict):
            continue
        key = entry.get("key")
        if not isinstance(key, str) or not key:
            continue
        if isinstance(scope, str) and scope.startswith(_GROK_OIDC_PREFIX):
            oidc = (scope, entry)
        elif scope == _GROK_LEGACY_SCOPE or (
            isinstance(scope, str) and "/sign-in" in scope
        ):
            legacy = (scope, entry)
    preferred = oidc or legacy
    if not preferred:
        raise ProviderError(
            f"no access token in {auth_file} (re-run 'grok login')."
        )
    scope, entry = preferred
    return {
        "access_token": entry["key"],
        "scope": scope,
        "auth_mode": entry.get("auth_mode"),
        "email": entry.get("email"),
        "team_id": entry.get("team_id"),
        "first_name": entry.get("first_name"),
        "last_name": entry.get("last_name"),
        "expires_at": _grok_parse_iso(entry.get("expires_at")),
    }


def _grok_login_method(auth_mode) -> str | None:
    if not auth_mode:
        return None
    low = str(auth_mode).lower()
    if low == "oidc":
        return "SuperGrok"
    if low == "session":
        return "session"
    return str(auth_mode)


def _grok_primary_label(resets_at: float | None, now: float | None = None) -> str:
    """Weekly / Monthly when the cycle length matches; else Credits."""
    if resets_at is None:
        return "Credits"
    now = time.time() if now is None else now
    seconds = resets_at - now
    if seconds <= 3600:
        return "Credits"
    days = int(round(seconds / 86400))
    if 4 <= days <= 12:
        return "Weekly"
    if 20 <= days <= 45:
        return "Monthly"
    return "Credits"


# --- gRPC-web protobuf helpers (ported from CodexBar GrokWebBillingFetcher) ---


def _pb_read_varint(buf: bytes, index: int) -> tuple[int | None, int]:
    value = 0
    shift = 0
    n = len(buf)
    while index < n and shift < 64:
        byte = buf[index]
        index += 1
        value |= (byte & 0x7F) << shift
        if byte & 0x80 == 0:
            return value, index
        shift += 7
    return None, index


def _pb_scan(data: bytes, depth: int = 0, path: tuple = ()) -> tuple[list, list]:
    """Return (fixed32_fields, varint_fields).

    fixed32_fields: list of (path, float_value, order)
    varint_fields:  list of (path, uint_value)
    """
    fixed32: list = []
    varint: list = []
    index = 0
    order = 0
    n = len(data)
    while index < n:
        start = index
        key, index = _pb_read_varint(data, index)
        if key is None or key == 0:
            index = start + 1
            continue
        field_number = key >> 3
        wire_type = key & 0x07
        field_path = path + (field_number,)

        if wire_type == 0:  # varint
            val, index = _pb_read_varint(data, index)
            if val is not None:
                varint.append((field_path, val))
            else:
                index = start + 1
        elif wire_type == 1:  # 64-bit
            if index + 8 > n:
                break
            index += 8
        elif wire_type == 2:  # length-delimited
            length, index = _pb_read_varint(data, index)
            if length is None or index + length > n:
                index = start + 1
                continue
            nested = data[index:index + length]
            if depth < 4:
                f, v = _pb_scan(nested, depth + 1, field_path)
                fixed32.extend(f)
                varint.extend(v)
            index += length
        elif wire_type == 5:  # 32-bit
            if index + 4 > n:
                break
            bits = (data[index]
                    | (data[index + 1] << 8)
                    | (data[index + 2] << 16)
                    | (data[index + 3] << 24))
            fval = struct.unpack("<f", struct.pack("<I", bits & 0xFFFFFFFF))[0]
            fixed32.append((field_path, fval, order))
            order += 1
            index += 4
        else:
            index = start + 1
    return fixed32, varint


def _grpc_web_data_frames(data: bytes) -> list[bytes]:
    frames: list[bytes] = []
    index = 0
    n = len(data)
    while index < n:
        if index + 5 > n:
            return []
        flags = data[index]
        length = ((data[index + 1] << 24)
                  | (data[index + 2] << 16)
                  | (data[index + 3] << 8)
                  | data[index + 4])
        start = index + 5
        end = start + length
        if length < 0 or end > n:
            return []
        if flags & 0x80 == 0:
            frames.append(data[start:end])
        index = end
    return frames


def _grpc_web_trailer_fields(data: bytes) -> dict[str, str]:
    fields: dict[str, str] = {}
    index = 0
    n = len(data)
    while index + 5 <= n:
        flags = data[index]
        length = ((data[index + 1] << 24)
                  | (data[index + 2] << 16)
                  | (data[index + 3] << 8)
                  | data[index + 4])
        start = index + 5
        end = start + length
        if length < 0 or end > n:
            break
        if flags & 0x80 != 0:
            text = data[start:end].decode("utf-8", "replace")
            for line in text.splitlines():
                if not line or ":" not in line:
                    continue
                key, _, val = line.partition(":")
                fields[key.strip().lower()] = val.strip()
        index = end
    return fields


def _looks_like_protobuf(data: bytes) -> bool:
    if not data:
        return False
    first = data[0]
    field_number = first >> 3
    wire_type = first & 0x07
    return field_number > 0 and wire_type in (0, 1, 2, 5)


def _grok_parse_billing(data: bytes, now: float | None = None) -> tuple[float, float | None]:
    """Parse GetGrokCreditsConfig response → (used_percent, resets_at_epoch|None)."""
    now = time.time() if now is None else now
    payloads = _grpc_web_data_frames(data)
    if not payloads and _looks_like_protobuf(data):
        payloads = [data]
    if not payloads:
        raise ProviderError("Grok web billing returned no protobuf payload.")

    trailers = _grpc_web_trailer_fields(data)
    if "grpc-status" in trailers:
        try:
            status = int(trailers["grpc-status"])
        except ValueError:
            status = -1
        if status != 0:
            msg = trailers.get("grpc-message", "")
            if status == 16 or "unauth" in msg.lower() or "credential" in msg.lower():
                raise ProviderError(
                    "token expired or invalid (run 'grok login')."
                )
            raise ProviderError(f"Grok billing RPC failed (status {status}): {msg}")

    fixed32: list = []
    varint: list = []
    for payload in payloads:
        f, v = _pb_scan(payload)
        fixed32.extend(f)
        varint.extend(v)

    percent_cands = [
        f for f in fixed32
        if f[0] and f[0][-1] == 1
        and math.isfinite(f[1]) and 0.0 <= f[1] <= 100.0
    ]
    parsed_percent = None
    if percent_cands:
        # Prefer shallowest path, then earliest order (mirrors CodexBar).
        best = min(percent_cands, key=lambda x: (len(x[0]), x[2]))
        parsed_percent = float(best[1])

    reset_fields = []
    for path, val in varint:
        if 1_700_000_000 <= val <= 2_100_000_000:
            reset_fields.append((path, float(val)))
    future = [(p, t) for p, t in reset_fields if t > now]
    preferred = [t for p, t in future if p == (1, 5, 1)]
    resets_at = min(preferred) if preferred else (
        min((t for _, t in future), default=None)
    )

    has_usage_period = any(
        (p[:2] == (1, 6)) or (p == (1, 8, 1) and v in (1, 2))
        for p, v in varint
    )
    if parsed_percent is None:
        if resets_at is not None and has_usage_period and not fixed32:
            parsed_percent = 0.0
        else:
            raise ProviderError("Could not parse Grok web billing usage.")

    return parsed_percent, resets_at


def _grok_fetch_web_billing(access_token: str) -> tuple[float, float | None]:
    headers = {
        "Authorization": f"Bearer {access_token}",
        "Origin": "https://grok.com",
        "Referer": "https://grok.com/?_s=usage",
        "Accept": "*/*",
        "Content-Type": "application/grpc-web+proto",
        "x-grpc-web": "1",
        "x-user-agent": "connect-es/2.1.1",
        "User-Agent": "llm-limits",
    }
    # Empty gRPC-web frame (flags=0, length=0) — matches CodexBar.
    body = bytes([0x00, 0x00, 0x00, 0x00, 0x00])
    status, data, resp_headers = http_post_raw(
        _GROK_BILLING_URL, body=body, headers=headers, timeout=20
    )
    if status in (401, 403):
        raise ProviderError("token expired or invalid (run 'grok login').")
    if status != 200:
        detail = data[:200].decode("utf-8", "replace") if data else ""
        raise ProviderError(
            f"usage request failed (HTTP {status}) {detail}".rstrip()
        )

    # Also honor grpc-status when delivered as an HTTP header.
    grpc_status = None
    for k, v in resp_headers.items():
        if str(k).lower() == "grpc-status":
            try:
                grpc_status = int(str(v).strip())
            except ValueError:
                pass
    if grpc_status not in (None, 0):
        msg = ""
        for k, v in resp_headers.items():
            if str(k).lower() == "grpc-message":
                msg = str(v)
                break
        if grpc_status == 16:
            raise ProviderError("token expired or invalid (run 'grok login').")
        raise ProviderError(f"Grok billing RPC failed (status {grpc_status}): {msg}")

    return _grok_parse_billing(data)


def do_grok() -> int:
    creds = _grok_load_credentials()
    pct, resets_at = _grok_fetch_web_billing(creds["access_token"])

    method = _grok_login_method(creds.get("auth_mode"))
    email = creds.get("email")
    meta = []
    if method:
        meta.append(method)
    #if isinstance(email, str) and email:
    #    meta.append(email)
    header("Grok", *meta)

    label = _grok_primary_label(resets_at).lower()
    usage_row(label, round(pct, 1) if pct is not None else None,
              reset=int(resets_at) if resets_at else None)
    return 0


# --------------------------------------------------------------------------- #
# all — run every provider concurrently, print each as it finishes
# --------------------------------------------------------------------------- #

# Thread-local stdout so concurrent providers can capture their own prints
# without racing on the process-global sys.stdout (contextlib.redirect_stdout
# is not thread-safe).
_stdout_tls = threading.local()
_stdout_real = sys.stdout
_stdout_proxy_installed = False
_stdout_proxy_lock = threading.Lock()


class _ThreadLocalStdout:
    """Proxy that routes write/flush to a per-thread buffer when set."""

    def write(self, data):  # noqa: ANN001
        stream = getattr(_stdout_tls, "buf", None)
        return (stream if stream is not None else _stdout_real).write(data)

    def writelines(self, lines):  # noqa: ANN001
        for line in lines:
            self.write(line)

    def flush(self) -> None:
        stream = getattr(_stdout_tls, "buf", None)
        (stream if stream is not None else _stdout_real).flush()

    def isatty(self) -> bool:
        # Keep color decisions based on the real terminal, not the capture buffer.
        return _stdout_real.isatty()

    def fileno(self) -> int:
        return _stdout_real.fileno()

    @property
    def encoding(self):
        return getattr(_stdout_real, "encoding", "utf-8")

    @property
    def errors(self):
        return getattr(_stdout_real, "errors", "replace")

    def reconfigure(self, *args, **kwargs):  # noqa: ANN002, ANN003
        reconf = getattr(_stdout_real, "reconfigure", None)
        if reconf is not None:
            return reconf(*args, **kwargs)
        return None

    def __getattr__(self, name: str):
        return getattr(_stdout_real, name)


def _install_stdout_proxy() -> None:
    global _stdout_proxy_installed, _stdout_real
    with _stdout_proxy_lock:
        if _stdout_proxy_installed:
            return
        # Capture whatever is currently wired as stdout (may already be wrapped).
        _stdout_real = sys.stdout
        sys.stdout = _ThreadLocalStdout()
        _stdout_proxy_installed = True


def _capture_provider(name: str, func) -> str | None:
    """Run one provider, capturing stdout into a private buffer.

    Returns the rendered block text, or None when the provider is skipped
    (no credentials). Errors are rendered into the block so the caller can
    still stream them. Safe to call from a worker thread.
    """
    _install_stdout_proxy()
    buf = io.StringIO()
    _stdout_tls.buf = buf
    try:
        try:
            func()
        except _Skip:
            return None
        except ProviderError as e:
            # Clear any partial output, then render a clean error block.
            buf.seek(0)
            buf.truncate(0)
            header(name)
            note(str(e))
        except urllib.error.URLError as e:
            buf.seek(0)
            buf.truncate(0)
            header(name)
            note(f"network error: {e.reason}")
        except Exception as e:  # noqa: BLE001 — surface unexpected worker failures
            buf.seek(0)
            buf.truncate(0)
            header(name)
            note(f"unexpected error: {e}")
        text = buf.getvalue()
        return text if text else None
    finally:
        _stdout_tls.buf = None


def _emit_block(text: str) -> None:
    """Write one provider block + trailing blank line; flush so it shows immediately."""
    if not text.endswith("\n"):
        text += "\n"
    # Always write through the real terminal, never a worker capture buffer.
    out = _stdout_real
    out.write(text)
    out.write("\n")
    out.flush()


def do_all() -> int:
    # Fire every provider at once; print a block as soon as its future completes.
    # Skipped providers (no credentials) produce nothing. Completion order is
    # network-dependent — not the declaration order below.
    providers = [
        ("GLM", do_glm),
        ("DeepSeek", do_deepseek),
        ("Codex", do_codex),
        ("Grok", do_grok),
    ]
    _install_stdout_proxy()
    ok = 0
    with concurrent.futures.ThreadPoolExecutor(
        max_workers=len(providers),
        thread_name_prefix="llm-limits",
    ) as pool:
        futures = [
            pool.submit(_capture_provider, name, func)
            for name, func in providers
        ]
        for fut in concurrent.futures.as_completed(futures):
            try:
                text = fut.result()
            except Exception as e:  # noqa: BLE001
                _emit_block(f"{C_CYAN('●')} {C_BOLD('?')}\n  {C_DIM(str(e))}")
                ok += 1
                continue
            if text:
                _emit_block(text)
                ok += 1
    return 0 if ok > 0 else 1


# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="llm_limits.py",
        description="Print AI provider usage / quota / balance to the terminal. "
                    "Credentials are read from the environment, with pass-sliver fallback.",
    )
    sub = parser.add_subparsers(dest="provider")

    sub.add_parser("all", help="print glm + deepseek + codex + grok (default)")
    sub.add_parser("glm", help="GLM / z.ai (智谱) quota windows")
    sub.add_parser("deepseek", help="DeepSeek balance + monthly usage")
    sub.add_parser("codex", help="OpenAI Codex OAuth usage windows")
    sub.add_parser("grok", help="xAI Grok Build credit usage")

    return parser


_PROVIDERS = {
    "all": do_all,
    "glm": do_glm,
    "deepseek": do_deepseek,
    "codex": do_codex,
    "grok": do_grok,
}


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    func = _PROVIDERS.get(args.provider) or do_all  # default to `all`
    try:
        return func()
    except ProviderError as e:
        die(str(e))
        return 1  # unreachable
    except urllib.error.URLError as e:
        die(f"network error: {e.reason}")
        return 2  # unreachable


if __name__ == "__main__":
    sys.exit(main())
