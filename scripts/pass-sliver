#!/usr/bin/env bash
set -euo pipefail

export PASSWORD_STORE_DIR="$CHIN_PRIVATE_DIR/certs/sliver-store2"
export GNUPGHOME="$PASSWORD_STORE_DIR/.gnupg"

_die() {
    printf 'pass-sliver: %s\n' "$*" >&2
    exit 1
}

_require_command() {
    local command_name="$1"

    command -v "$command_name" >/dev/null 2>&1 || \
        _die "required command not found: $command_name"
}

_put() {
    [[ $# -eq 1 ]] || _die 'put requires exactly one ENTRY argument'

    local entry="$1"
    [[ -n $entry ]] || _die 'put entry must not be empty'
    [[ $entry != *=* ]] || \
        _die 'put entry must not contain =; use put ENTRY and enter the password at the prompt'

    pass insert --force "$entry"
}

_put_file() {
    [[ $# -eq 2 ]] || _die 'put-file requires FILE_OR_DIR and ENTRY'

    local source_path="$1"
    local entry="$2"
    [[ -e $source_path ]] || _die "file or directory not found: $source_path"
    [[ -n $entry ]] || _die 'put-file entry must not be empty'

    _require_command tar
    _require_command base64

    tar -cf - -- "$source_path" |
        base64 |
        pass insert --force --multiline "$entry"
}

_get() {
    [[ $# -eq 1 ]] || _die 'get requires exactly one ENTRY'

    pass show "$1"
}

_get_file() {
    [[ $# -ge 1 && $# -le 3 ]] || \
        _die 'get-file requires ENTRY [-o OUTPUT_DIR]'

    local entry="$1"
    local output_dir="${XDG_RUNTIME_DIR:-}"
    shift

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -o|--output)
                [[ $# -ge 2 ]] || _die "$1 requires an output directory"
                output_dir="$2"
                shift 2
                ;;
            *)
                _die "unknown get-file argument: $1"
                ;;
        esac
    done

    [[ -n $output_dir ]] || \
        _die 'XDG_RUNTIME_DIR is not set; use -o OUTPUT_DIR'

    _require_command tar
    _require_command base64
    mkdir -p -- "$output_dir"

    pass show "$entry" |
        base64 --decode |
        tar -xf - -C "$output_dir"
}

_main() {
    [[ $# -gt 0 ]] || exec pass

    local command_name="$1"
    shift

    case "$command_name" in
        put)
            _put "$@"
            ;;
        put-file)
            _put_file "$@"
            ;;
        get)
            _get "$@"
            ;;
        get-file)
            _get_file "$@"
            ;;
        *)
            exec pass "$command_name" "$@"
            ;;
    esac
}

_main "$@"
