#!/usr/bin/env bash

set -euo pipefail

msg() { printf "\033[32m==> %s %s ~ \033[0m%s\n" "$(date +%H:%M:%S)" "$*"; }
warn() { printf "\033[33m==> %s %s ~ %s\033[0m\n" "$(date +%H:%M:%S)" "$*"; }
error() { printf "\033[31m==> %s %s ~ %s\033[0m\n" "$(date +%H:%M:%S)" "$*"; }
die() {
    error "$@"
    exit 1
}

declare -a DSTS=()
WRITE_FLAG=false
FILE_TYPE=""

_kfmt_path_ext() {
    local fp="$1" ext="${2:-}"

    case "$ext" in
    sh)
        $WRITE_FLAG && { shfmt -w -i 4 "$fp"; } || { shfmt -i 4 "$fp"; }
        ;;
    py)
        # pacman: ruff  /  uv tool install ruff
        $WRITE_FLAG \
          && { ruff format --no-cache "$fp"; } \
          || { ruff format --no-cache --stdin-filename="$fp" - <"$fp"; }
        ;;
    json)
        $WRITE_FLAG && { yq -P -o json -i "$fp"; } || { yq -P -o json "$fp"; }
        ;;
    toml)
        # pacman: taplo-cli
        $WRITE_FLAG \
          && { taplo format "$fp"; } \
          || { taplo format - <"$fp"; }
        ;;
    xml)
        $WRITE_FLAG && { yq -P -o xml -i "$fp"; } || { yq -P -o xml "$fp"; }
        ;;
    lua)
        # cargo install stylua
        $WRITE_FLAG \
          && { stylua --indent-type Spaces --indent-width 2 "$fp"; } \
          || { cat "$fp" | stylua --indent-type Spaces --indent-width 2 --stdin-filepath - -; }
        ;;
    js | mjs | cjs | jsx | ts | mts | cts | tsx | css)
        # pacman: biome
        $WRITE_FLAG \
          && { biome format --write "$fp"; } \
          || { biome format --stdin-file-path="$fp" <"$fp"; }
        ;;
    rs)
        # pacman: rust / rustup component add rustfmt
        $WRITE_FLAG \
          && { rustfmt "$fp"; } \
          || { rustfmt --emit stdout "$fp"; }
        ;;
    go)
        # pacman: go
        $WRITE_FLAG \
          && { gofmt -w "$fp"; } \
          || { gofmt "$fp"; }
        ;;
    yaml | yml)
        # pacman: yamlfmt
        $WRITE_FLAG \
          && { yamlfmt "$fp"; } \
          || { yamlfmt - <"$fp"; }
        ;;
    sql)
        # pacman: pgformatter
        $WRITE_FLAG \
          && { pg_format -i "$fp"; } \
          || { pg_format "$fp"; }
        ;;
    *)
        warn "unsupported file type: $ext"
        ;;
    esac
}

_kfmt_stdin_ext() {
    # Format stdin -> stdout. No write-back; -w/-i is ignored.
    local ext="$1"

    case "$ext" in
    sh)
        shfmt -i 4
        ;;
    py)
        ruff format --no-cache --stdin-filename=stdin.py -
        ;;
    json)
        yq -P -o json
        ;;
    toml)
        taplo format -
        ;;
    xml)
        yq -P -o xml
        ;;
    lua)
        stylua --indent-type Spaces --indent-width 2 --stdin-filepath - -
        ;;
    js | mjs | cjs | jsx | ts | mts | cts | tsx | css)
        biome format --stdin-file-path="stdin.$ext"
        ;;
    rs)
        rustfmt
        ;;
    go)
        gofmt
        ;;
    yaml | yml)
        yamlfmt -
        ;;
    sql)
        pg_format
        ;;
    *)
        warn "unsupported file type: $ext"
        return 1
        ;;
    esac
}

_format_file() {
    local mime
    local fp="$1"
    local ext

    if [[ "$fp" == *.* ]]; then
        ext="${fp##*.}"
        _kfmt_path_ext "$fp" "$ext"
    else
        mime="$(file --mime "$fp")"
        case "$mime" in
        *text/x-shellscript*)
            _kfmt_path_ext "$fp" "sh"
            ;;
        *text/x-script.python*)
            _kfmt_path_ext "$fp" "py"
            ;;
        *text/x-rust* | *text/rust*)
            _kfmt_path_ext "$fp" "rs"
            ;;
        *text/x-go* | *text/x-gofile*)
            _kfmt_path_ext "$fp" "go"
            ;;
        *text/yaml* | *text/x-yaml* | *application/yaml*)
            _kfmt_path_ext "$fp" "yaml"
            ;;
        *text/x-sql* | *application/sql*)
            _kfmt_path_ext "$fp" "sql"
            ;;
        *)
            warn "cannot detect file type: $fp"
            ;;
        esac
    fi
}

_show_help() {
    cat <<'EOF'
Usage: kfmt [-i|-w] [-t TYPE] FILE...
       kfmt -t TYPE        # read stdin when piped, write stdout

Options:
  -i, -w     Write formatted result back to file
  -t TYPE    Force file type (sh, py, json, toml, xml, lua, rs, go,
             yaml, yml, sql, js, mjs, cjs, jsx, ts, mts, cts, tsx, css)
  -h, --help Show this help message

With no FILE and a piped stdin, formats stdin to stdout (-t required).
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
    -i | -w) WRITE_FLAG=true ;;
    -t)
        [[ -n $FILE_TYPE ]] && die "'-t' can only be used once."
        shift
        FILE_TYPE="$1"
        ;;
    -h | --help)
        _show_help
        exit 0
        ;;
    *) DSTS=("${DSTS[@]}" "$1") ;;
    esac
    shift
done

# No FILE args: if stdin is piped, format it to stdout (-t required);
# otherwise it's an interactive/terminal invocation — show help.
if [[ ${#DSTS[@]} -eq 0 ]]; then
    if [[ -t 0 ]]; then
        _show_help
        exit 1
    fi
    [[ -z $FILE_TYPE ]] && die "stdin mode requires '-t TYPE' (sh, py, json, toml, xml, lua, rs, go, yaml, sql, js, ts, css, ...)."
    _kfmt_stdin_ext "$FILE_TYPE"
    exit
fi

for dst in "${DSTS[@]}"; do
    if [[ -n $FILE_TYPE ]]; then
        _kfmt_path_ext "$dst" "$FILE_TYPE"
    else
        _format_file "$dst"
    fi
done
