#!/usr/bin/env bash

set -eu

CMN_DIR="$HOME/.local/share/fkhome"
CMN_PFL="$CMN_DIR/env.sh"
WDIR="$(realpath -s "$1")"
PMD5=$(echo "$WDIR" | md5sum | awk '{print $1}')

shift
CMDS=("$@")

mkdir -p "/tmp/$PMD5"

try_load() {
    echo "-> try to loading $1"
    if [ -f "$1" ]; then
        echo "->> LOAD $1"
        source "$1"
    fi
}

try_load "$CMN_PFL"
try_load "$WDIR.sh"

ARGS=(
    --ro-bind /usr /usr
    --ro-bind /etc /etc
    --ro-bind /opt /opt
    --symlink usr/bin /bin
    --symlink usr/lib /lib
    --symlink usr/lib64 /lib64
    --proc /proc
    --dev /dev
    --dev-bind-try /dev/dri /dev/dri
    --ro-bind-try /sys /sys
    --tmpfs /tmp/$PMD5
    --bind-try /tmp/.X11-unix /tmp/.X11-unix
    --bind-try /run/dbus /run/dbus
    --bind-try "$HOME/.cargo" /home/agent/.cargo
    --bind "$WDIR" /home/agent
    --setenv HOME /home/agent
    --setenv XDG_CONFIG_HOME /home/agent/.config
    --setenv HTTP_PROXY "$CHIN_HTTP_PROXY"
    --setenv HTTPS_PROXY "$CHIN_HTTP_PROXY"
    --setenv PATH "/usr/local/sbin:/usr/local/bin:/usr/bin:/opt/android-ndk:/usr/lib/jvm/default/bin:/usr/bin/site_perl:/usr/bin/vendor_perl:/usr/bin/core_perl:/usr/lib/rustup/bin"
    "${EXTRA_ARGS[@]}"
)


if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    ARGS+=(--bind "$XDG_RUNTIME_DIR" "$XDG_RUNTIME_DIR")
fi

echo "cd $WDIR"
cd "$WDIR"

if [ "${#CMDS}" -eq 0 ]; then
    exec bwrap "${ARGS[@]}" zsh
else
    exec bwrap "${ARGS[@]}" "${CMDS[@]}"
fi
