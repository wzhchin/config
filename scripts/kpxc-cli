#!/usr/bin/env -S uv run -s
# /// script
# requires-python = ">=3.10"
# dependencies = [
#     "pynacl>=1.5",
# ]
# ///
"""
kpxc-cli - CLI for KeePassXC using the browser extension protocol.

A Python port of the Rust `kpxc-cli` (src/). Talks to KeePassXC over its
Windows named-pipe browser-integration protocol with NaCl-encrypted JSON.

Windows-only. This is a standalone uv / PEP 723 script: dependencies
(declared in the `# /// script` block above) are resolved automatically.

Run it any of these ways:

    uv run kpxc-cli.py status          # uv (recommended; auto-isolates deps)
    ./kpxc-cli.py status               # the shebang launches it via `uv run -s`
    python kpxc-cli.py status          # plain interpreter (needs `pip install pynacl`)

The on-disk config files are byte-compatible with the Rust tool and the
upstream Python `keepassxc-browser-api`:
    %USERPROFILE%\\.keepassxc\\browser-api.json
    %USERPROFILE%\\.keepassxc\\cli.json
"""

from __future__ import annotations

import argparse
import ctypes
import getpass
import json
import os
import sys
import threading
import time
from ctypes import wintypes
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Iterable, Optional

import nacl.bindings
import nacl.public
from base64 import b64decode, b64encode


# =====================================================================================
# Exit codes & errors
# =====================================================================================

EXIT_SUCCESS = 0
EXIT_GENERIC = 1
EXIT_CONNECTION = 2
EXIT_DATABASE_LOCKED = 3
EXIT_ACCESS_DENIED = 4


class KeePassXCError(Exception):
    """All errors raised by the protocol/client layer.

    ``kind`` is one of: connection, association, not_associated,
    database_locked, protocol. ``error_code`` carries KeePassXC's errorCode
    when present so the CLI can map "access denied" (6 / 19) distinctly.
    """

    def __init__(self, message: str = "", *, kind: str = "protocol",
                 error_code: Optional[int] = None):
        super().__init__(message)
        self.message = message
        self.kind = kind
        self.error_code = error_code

    def exit_code(self) -> int:
        if self.kind == "connection":
            return EXIT_CONNECTION
        if self.kind == "database_locked":
            return EXIT_DATABASE_LOCKED
        if self.kind == "protocol" and self.error_code in (6, 19):
            return EXIT_ACCESS_DENIED
        return EXIT_GENERIC

    def __str__(self) -> str:
        if self.error_code is not None:
            return f"{self.message} (code {self.error_code})"
        return self.message


def _conn(msg: str) -> KeePassXCError:
    return KeePassXCError(msg, kind="connection")


def _proto(msg: str, code: Optional[int] = None) -> KeePassXCError:
    return KeePassXCError(msg, kind="protocol", error_code=code)


def _assoc(msg: str) -> KeePassXCError:
    return KeePassXCError(msg, kind="association")


def _not_assoc(msg: str) -> KeePassXCError:
    return KeePassXCError(msg, kind="not_associated")


def _db_locked(msg: str) -> KeePassXCError:
    return KeePassXCError(msg, kind="database_locked")


# =====================================================================================
# Config (browser-api.json + cli.json)
# =====================================================================================

DEFAULT_UNLOCK_TIMEOUT = 30


def config_dir() -> Path:
    return Path.home() / ".keepassxc"


def default_browser_api_config_path() -> Path:
    return config_dir() / "browser-api.json"


def default_cli_config_path() -> Path:
    return config_dir() / "cli.json"


@dataclass
class Association:
    """A stored client<->database association."""

    id: str = ""
    # base64 identity *public* key (idKey on the wire)
    id_key: str = ""
    # base64 identity *secret* key; never sent over the wire
    key: str = ""

    def to_dict(self) -> dict:
        return {"id": self.id, "id_key": self.id_key, "key": self.key}

    @classmethod
    def from_dict(cls, d: dict) -> "Association":
        return cls(
            id=d.get("id", ""),
            id_key=d.get("id_key", d.get("idKey", "")),
            key=d.get("key", ""),
        )


@dataclass
class BrowserConfig:
    """Top-level shape of ``browser-api.json``."""

    unlock_timeout: int = DEFAULT_UNLOCK_TIMEOUT
    client_public_key: str = ""
    client_secret_key: str = ""
    associations: dict = field(default_factory=dict)  # db_hash -> Association

    def to_dict(self) -> dict:
        return {
            "unlock_timeout": self.unlock_timeout,
            "client_public_key": self.client_public_key,
            "client_secret_key": self.client_secret_key,
            "associations": {k: v.to_dict() for k, v in self.associations.items()},
        }

    @classmethod
    def from_dict(cls, d: dict) -> "BrowserConfig":
        raw = d.get("associations", {}) or {}
        return cls(
            unlock_timeout=int(d.get("unlock_timeout", DEFAULT_UNLOCK_TIMEOUT)),
            client_public_key=d.get("client_public_key", ""),
            client_secret_key=d.get("client_secret_key", ""),
            associations={k: Association.from_dict(v) for k, v in raw.items()},
        )

    @classmethod
    def load(cls, path: Path) -> "BrowserConfig":
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return cls()
        return cls.from_dict(data)

    def save(self, path: Path) -> None:
        """Atomically persist with owner-only ACL."""
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(self.to_dict(), indent=2), encoding="utf-8")
        _restrict_acl_owner_only(tmp)
        os.replace(tmp, path)

    def associations_iter(self) -> Iterable[Association]:
        return self.associations.values()

    def first_association(self) -> Optional[Association]:
        for v in self.associations.values():
            return v
        return None


@dataclass
class CliConfig:
    browser_api_config_path: str = ""
    default_format: str = ""

    def browser_api_config_path_effective(self) -> Path:
        if not self.browser_api_config_path:
            return default_browser_api_config_path()
        return Path(self.browser_api_config_path)

    def default_format_effective(self) -> str:
        return self.default_format or "table"

    @classmethod
    def load(cls, path: Path) -> "CliConfig":
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return cls()
        return cls(
            browser_api_config_path=data.get("browser_api_config_path", ""),
            default_format=data.get("default_format", ""),
        )

    def save(self, path: Path) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        d: dict = {}
        if self.browser_api_config_path:
            d["browser_api_config_path"] = self.browser_api_config_path
        if self.default_format and self.default_format != "table":
            d["default_format"] = self.default_format
        tmp = path.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(d, indent=2), encoding="utf-8")
        os.replace(tmp, path)


def _restrict_acl_owner_only(path: Path) -> None:
    """Replace the file's DACL with a null (owner-only) one, mirroring the
    Rust FFI call to ``SetNamedSecurityInfoW``. Best-effort: failures only
    produce a warning on stderr."""
    try:
        advapi32 = ctypes.WinDLL("advapi32")
        SE_FILE_OBJECT = 1
        DACL_SECURITY_INFORMATION = 0x0000_0004
        PROTECTED_DACL_SECURITY_INFORMATION = 0x8000_0000
        info = DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION

        advapi32.SetNamedSecurityInfoW.argtypes = [
            wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD,
            wintypes.LPVOID, wintypes.LPVOID, wintypes.LPVOID, wintypes.LPVOID,
        ]
        advapi32.SetNamedSecurityInfoW.restype = wintypes.DWORD

        result = advapi32.SetNamedSecurityInfoW(
            str(path), SE_FILE_OBJECT, info, None, None, None, None
        )
        if result != 0:
            sys.stderr.write(
                f"warning: could not restrict permissions on {path} "
                f"(WinErr {result})\n"
            )
    except Exception as exc:  # pragma: no cover - best effort
        sys.stderr.write(
            f"warning: could not restrict permissions on {path} ({exc})\n"
        )


# =====================================================================================
# Data models
# =====================================================================================

@dataclass
class Entry:
    """A KeePassXC entry as returned by get-logins / get-database-entries."""

    uuid: str = ""
    name: str = ""
    login: str = ""
    password: str = ""
    totp: str = ""
    group: str = ""
    group_uuid: str = ""
    string_fields: list = field(default_factory=list)

    @classmethod
    def from_dict(cls, d: dict) -> "Entry":
        return cls(
            uuid=d.get("uuid", "") or "",
            name=d.get("name", "") or "",
            login=d.get("login", "") or "",
            password=d.get("password", "") or "",
            totp=d.get("totp", "") or "",
            group=d.get("group", "") or "",
            group_uuid=d.get("groupUuid", "") or "",
            string_fields=list(d.get("stringFields", []) or []),
        )


@dataclass
class Group:
    """A KeePassXC group, possibly with nested children."""

    uuid: str = ""
    name: str = ""
    children: list = field(default_factory=list)

    @classmethod
    def from_dict(cls, d: dict) -> "Group":
        # KeePassXC historically nests under "children"; some versions use
        # "groups". Accept either.
        kids = d.get("children")
        if kids is None:
            kids = d.get("groups", []) or []
        return cls(
            uuid=d.get("uuid", "") or "",
            name=d.get("name", "") or "",
            children=[cls.from_dict(c) for c in kids],
        )

    def flat(self) -> list:
        out = [self]
        for child in self.children:
            out.extend(child.flat())
        return out


def connection_keys(associations: Iterable[Association]) -> list:
    """Build the ``keys`` array every authenticated request must include."""
    return [{"id": a.id, "key": a.id_key} for a in associations]


# =====================================================================================
# NaCl crypto_box helpers (Curve25519 + XSalsa20 + Poly1305)
# =====================================================================================

NONCE_SIZE = 24  # crypto_box_NONCEBYTES


def generate_secret_key() -> nacl.public.PrivateKey:
    return nacl.public.PrivateKey.generate()


def random_nonce() -> bytes:
    return os.urandom(NONCE_SIZE)


def encode_bytes(b: bytes) -> str:
    return b64encode(b).decode("ascii")


def decode_nonce(b64: str) -> bytes:
    raw = b64decode(b64.strip())
    if len(raw) != NONCE_SIZE:
        raise _proto(
            f"Nonce must be {NONCE_SIZE} bytes, got {len(raw)}"
        )
    return raw


def decode_public_key(b64: str) -> nacl.public.PublicKey:
    try:
        return nacl.public.PublicKey(b64decode(b64.strip()))
    except Exception as exc:
        raise _proto(f"Invalid public key: {exc}")


def decode_secret_key(b64: str) -> nacl.public.PrivateKey:
    try:
        return nacl.public.PrivateKey(b64decode(b64.strip()))
    except Exception as exc:
        raise _proto(f"Invalid secret key: {exc}")


def encrypt_json(our_sk: nacl.public.PrivateKey,
                 server_pk: nacl.public.PublicKey,
                 nonce: bytes, payload: Any) -> str:
    """Encrypt a JSON-serialisable payload; return base64 ciphertext.

    libsodium ``crypto_box`` layout is ``[16-byte Poly1305 tag || plaintext]``
    with the nonce transmitted separately - exactly what KeePassXC expects.
    """
    plaintext = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    try:
        ciphertext = nacl.bindings.crypto_box(
            plaintext, nonce, bytes(server_pk), bytes(our_sk)
        )
    except Exception as exc:
        raise _proto(f"Encryption failed: {exc}")
    return encode_bytes(ciphertext)


def decrypt_json(our_sk: nacl.public.PrivateKey,
                 server_pk: nacl.public.PublicKey,
                 nonce: bytes, ciphertext_b64: str) -> Any:
    try:
        ciphertext = b64decode(ciphertext_b64.strip())
    except Exception as exc:
        raise _proto(f"Invalid Base64 in response: {exc}")
    try:
        plaintext = nacl.bindings.crypto_box_open(
            ciphertext, nonce, bytes(server_pk), bytes(our_sk)
        )
    except Exception:
        raise _proto("Failed to decrypt response from KeePassXC")
    try:
        return json.loads(plaintext)
    except ValueError as exc:
        raise _proto(f"JSON error: {exc}")


# =====================================================================================
# Windows named-pipe transport
# =====================================================================================

NATIVEMSG_MAX_LENGTH = 1024 * 1024
DEFAULT_TIMEOUT = 5.0


def keepassxc_pipe_path() -> str:
    """Return the named-pipe path KeePassXC listens on for this user."""
    username = os.environ.get("USERNAME", "")
    if not username:
        # Fall back to the last segment of the user profile path.
        username = os.path.basename(os.environ.get("USERPROFILE", ""))
    return rf"\\.\pipe\org.keepassxc.KeePassXC.BrowserServer_{username}"


class PipeTransport:
    """A blocking client for the KeePassXC named pipe."""

    def __init__(self, fileobj, path: str):
        self._f = fileobj
        self.path = path

    @classmethod
    def connect(cls) -> "PipeTransport":
        return cls.connect_with(keepassxc_pipe_path())

    @classmethod
    def connect_with(cls, path: str) -> "PipeTransport":
        try:
            f = open(path, "r+b", buffering=0)
        except OSError as exc:
            raise _conn(
                f"Cannot connect to KeePassXC at {path}: {exc}. "
                "Is KeePassXC running with browser integration enabled?"
            )
        return cls(f, path)

    def close(self) -> None:
        try:
            self._f.close()
        except OSError:
            pass

    def request_raw(self, payload: str, timeout: float) -> dict:
        """Send a raw JSON request and return the first JSON object parsed
        from the reply. Enforces ``timeout`` via a worker thread."""
        if "KPXC_DEBUG" in os.environ:
            sys.stderr.write(f"[debug] -> {payload}\n")
        try:
            self._f.write(payload.encode("utf-8"))
        except OSError as exc:
            raise _conn(f"Connection error: {exc}")

        box: dict = {}

        def reader() -> None:
            buf = bytearray()
            try:
                while True:
                    try:
                        chunk = self._f.read(65536)
                    except OSError:
                        box["buf"] = None
                        return
                    if not chunk:
                        break
                    buf.extend(chunk)
                    if _has_complete_json(buf):
                        break
            except Exception:
                box["buf"] = None
                return
            box["buf"] = bytes(buf)

        t = threading.Thread(target=reader, daemon=True)
        t.start()
        t.join(timeout)
        if t.is_alive():
            # Timed out. The daemon thread keeps blocking on the pipe; it will
            # be cleaned up at process exit. The caller is expected to drop
            # this transport and reconnect, mirroring the Rust behaviour.
            raise _conn(
                f"Timed out waiting for KeePassXC response after {int(timeout)}s"
            )

        data = box.get("buf")
        if not data:
            raise _conn("KeePassXC closed the connection without responding")
        text = data.decode("utf-8", errors="replace")
        if "KPXC_DEBUG" in os.environ:
            sys.stderr.write(f"[debug] <- {text}\n")
        first = _first_json_object(text)
        if first is None:
            raise _proto(f"Could not parse JSON response from KeePassXC: {text}")
        try:
            return json.loads(first)
        except ValueError as exc:
            raise _proto(f"JSON error: {exc}")


def _has_complete_json(buf: bytes) -> bool:
    """True once the buffer starts with a complete JSON object."""
    try:
        text = buf.decode("utf-8", errors="ignore")
        json.JSONDecoder().raw_decode(text)
        return True
    except ValueError:
        return False


def _first_json_object(text: str) -> Optional[str]:
    """Extract the first complete JSON object's text, dropping any trailing
    concatenated broadcast message."""
    try:
        _obj, end = json.JSONDecoder().raw_decode(text)
    except ValueError:
        return None
    return text[:end].strip()


# =====================================================================================
# BrowserClient - the protocol implementation
# =====================================================================================

CLIENT_ID = "kpxc-cli-rs"
ASSOCIATE_TIMEOUT = 120.0
UNLOCK_POLL_INTERVAL = 1.0


class BrowserClient:
    """High-level API for talking to KeePassXC."""

    def __init__(self, config: BrowserConfig):
        self.config = config
        self._transport: Optional[PipeTransport] = None
        self._server_public_key: Optional[nacl.public.PublicKey] = None
        self._associated = False

        if config.client_secret_key:
            self._secret_key = decode_secret_key(config.client_secret_key)
            self._public_key = self._secret_key.public_key
        else:
            self._secret_key = generate_secret_key()
            self._public_key = self._secret_key.public_key
            config.client_public_key = encode_bytes(bytes(self._public_key))
            config.client_secret_key = encode_bytes(bytes(self._secret_key))

    # ---------------------------------------------------------------- connection
    def connect(self) -> None:
        self._transport = PipeTransport.connect()
        # A fresh connection always needs a new key exchange.
        self._server_public_key = None
        self._associated = False

    def disconnect(self) -> None:
        if self._transport is not None:
            self._transport.close()
            self._transport = None
            self._server_public_key = None
            self._associated = False

    def is_connected(self) -> bool:
        return self._transport is not None

    # ----------------------------------------------------------------- internals
    def _call_timeout(self) -> float:
        return float(max(self.config.unlock_timeout, 5))

    def _send_envelope(self, envelope: dict, timeout: float) -> dict:
        env = dict(envelope)
        env["clientID"] = CLIENT_ID
        payload = json.dumps(env, separators=(",", ":"))
        assert self._transport is not None
        return self._transport.request_raw(payload, timeout)

    def _assert_no_error(self, response: dict, action: str) -> None:
        if "errorCode" in response:
            code = _extract_error_code(response)
            msg = response.get("error", "unknown error")
            raise _proto(
                f"KeePassXC error for '{action}': {msg}", code
            )

    def _encrypt(self, nonce: bytes, payload: Any) -> str:
        if self._server_public_key is None:
            raise _proto("No server public key")
        return encrypt_json(self._secret_key, self._server_public_key, nonce, payload)

    def _decrypt(self, nonce: bytes, ciphertext_b64: str) -> Any:
        if self._server_public_key is None:
            raise _proto("No server public key")
        return decrypt_json(self._secret_key, self._server_public_key,
                            nonce, ciphertext_b64)

    def _send_encrypted(self, action: str, inner: dict) -> Any:
        self._ensure_session()
        nonce = random_nonce()
        ciphertext = self._encrypt(nonce, inner)
        envelope = {
            "action": action,
            "message": ciphertext,
            "nonce": encode_bytes(nonce),
        }
        response = self._send_envelope(envelope, self._call_timeout())
        self._assert_no_error(response, action)
        resp_nonce_b64 = response.get("nonce")
        resp_message = response.get("message")
        if not resp_nonce_b64 or not resp_message:
            raise _proto(f"Missing nonce/message in response for '{action}'")
        resp_nonce = decode_nonce(resp_nonce_b64)
        return self._decrypt(resp_nonce, resp_message)

    # -------------------------------------------------------- session lifecycle
    def _ensure_session(self) -> None:
        if (self._transport is not None
                and self._server_public_key is not None
                and self._associated):
            return
        if self._transport is None:
            self.connect()
        if self._server_public_key is None:
            self.change_public_keys()
        if not self._associated and not self._run_test_associate(False):
            # DB may be locked - trigger biometric unlock.
            self.trigger_unlock()
            if not self._run_test_associate(True):
                raise _assoc("All stored associations are invalid - re-run setup")

    def _ensure_keys(self) -> None:
        if self._transport is None:
            self.connect()
        if self._server_public_key is None:
            self.change_public_keys()

    def _run_test_associate(self, warn_on_failure: bool) -> bool:
        if not self.config.associations:
            if warn_on_failure:
                sys.stderr.write("warning: no associations stored - run `setup` first\n")
            return False
        for assoc in list(self.config.associations.values()):
            if self._test_associate_raw(assoc):
                self._associated = True
                return True
        if warn_on_failure:
            sys.stderr.write("warning: all stored associations are invalid - re-run setup\n")
        return False

    def _test_associate_raw(self, association: Association) -> bool:
        try:
            self._ensure_keys()
        except KeePassXCError:
            return False
        if self._server_public_key is None:
            return False
        nonce = random_nonce()
        inner = {
            "action": "test-associate",
            "id": association.id,
            "key": association.id_key,
        }
        ciphertext = self._encrypt(nonce, inner)
        envelope = {
            "action": "test-associate",
            "message": ciphertext,
            "nonce": encode_bytes(nonce),
        }
        try:
            response = self._send_envelope(envelope, self._call_timeout())
        except KeePassXCError:
            return False
        if "errorCode" in response:
            return False
        resp_nonce_b64 = response.get("nonce")
        resp_message = response.get("message")
        if not resp_nonce_b64 or not resp_message:
            return False
        try:
            resp_nonce = decode_nonce(resp_nonce_b64)
            self._decrypt(resp_nonce, resp_message)
        except KeePassXCError:
            if "KPXC_DEBUG" in os.environ:
                sys.stderr.write("[debug] test-associate failed\n")
            return False
        if "KPXC_DEBUG" in os.environ:
            sys.stderr.write("[debug] test-associate decrypted OK\n")
        return True

    def test_associate(self, association: Association) -> bool:
        return self._test_associate_raw(association)

    # ---------------------------------------------------- key exchange / assoc
    def change_public_keys(self) -> None:
        """Perform the unencrypted Curve25519 key exchange."""
        nonce = random_nonce()
        envelope = {
            "action": "change-public-keys",
            "publicKey": encode_bytes(bytes(self._public_key)),
            "nonce": encode_bytes(nonce),
        }
        response = self._send_envelope(envelope, self._call_timeout())
        self._assert_no_error(response, "change-public-keys")
        server_pk_b64 = response.get("publicKey")
        if not server_pk_b64:
            raise _conn("Key exchange failed: no server public key")
        self._server_public_key = decode_public_key(server_pk_b64)
        self._associated = False

    def associate(self) -> tuple:
        """One-time association flow. The user must approve in the GUI."""
        if self._server_public_key is None:
            raise _conn("associate called before key exchange")
        id_sk = generate_secret_key()
        id_pk = id_sk.public_key
        nonce = random_nonce()
        inner = {
            "action": "associate",
            "key": encode_bytes(bytes(self._public_key)),
            "idKey": encode_bytes(bytes(id_pk)),
        }
        ciphertext = self._encrypt(nonce, inner)
        envelope = {
            "action": "associate",
            "message": ciphertext,
            "nonce": encode_bytes(nonce),
        }
        response = self._send_envelope(envelope, ASSOCIATE_TIMEOUT)
        self._assert_no_error(response, "associate")
        resp_nonce_b64 = response.get("nonce")
        resp_message = response.get("message")
        if not resp_nonce_b64:
            raise _assoc("No nonce in associate response")
        if not resp_message:
            raise _assoc("No message in associate response")
        resp_nonce = decode_nonce(resp_nonce_b64)
        decrypted = self._decrypt(resp_nonce, resp_message)
        assoc_id = decrypted.get("id")
        if not assoc_id:
            raise _assoc("No id in associate response")
        db_hash = decrypted.get("hash", "")
        association = Association(
            id=assoc_id,
            id_key=encode_bytes(bytes(id_pk)),
            key=encode_bytes(bytes(id_sk)),
        )
        return db_hash, association

    # ---------------------------------------------------------- hash / unlock
    def _send_get_databasehash(self, trigger_unlock: bool) -> dict:
        nonce = random_nonce()
        inner = {"action": "get-databasehash"}
        ciphertext = self._encrypt(nonce, inner)
        envelope = {
            "action": "get-databasehash",
            "message": ciphertext,
            "nonce": encode_bytes(nonce),
        }
        if trigger_unlock:
            envelope["triggerUnlock"] = "true"
        return self._send_envelope(envelope, self._call_timeout())

    def trigger_unlock(self) -> None:
        """Pop the biometric unlock dialog and poll until the DB is open."""
        response = self._send_get_databasehash(True)
        if "errorCode" not in response:
            return  # already unlocked
        code = _extract_error_code(response)
        if code != 1:
            raise _db_locked(f"Unlock failed (code {code})")
        deadline = time.time() + self.config.unlock_timeout
        while time.time() < deadline:
            time.sleep(UNLOCK_POLL_INTERVAL)
            # Reconnect + re-exchange keys each iteration: KeePassXC drops
            # client state on disconnect.
            self.disconnect()
            try:
                self.connect()
                self.change_public_keys()
            except KeePassXCError:
                continue
            try:
                response = self._send_get_databasehash(False)
            except KeePassXCError:
                continue
            if "errorCode" not in response:
                return
        raise _db_locked(
            f"Timeout waiting for database unlock after {self.config.unlock_timeout}s"
        )

    def ensure_unlocked(self) -> None:
        if not self.config.associations:
            raise _not_assoc("No associations configured. Run `setup` first.")
        self.connect()
        try:
            self.change_public_keys()
            self.trigger_unlock()
        finally:
            self.disconnect()

    def setup(self) -> None:
        """First-time setup: connect, exchange keys, ask user to approve."""
        self.connect()
        try:
            self.change_public_keys()
            sys.stderr.write("Requesting association with KeePassXC...\n")
            sys.stderr.write("Please approve the association in the KeePassXC window.\n")
            db_hash, association = self.associate()
            if not db_hash:
                raise _assoc(
                    "KeePassXC returned no database hash - cannot store association"
                )
            self.config.associations[db_hash] = association
        finally:
            self.disconnect()

    # ------------------------------------------------------------------ read API
    def get_logins(self, url: str) -> list:
        inner = {
            "action": "get-logins",
            "url": url,
            "keys": connection_keys(self.config.associations_iter()),
        }
        try:
            decrypted = self._send_encrypted("get-logins", inner)
        except KeePassXCError as exc:
            if exc.error_code == 15:
                return []
            raise
        entries_val = decrypted.get("entries")
        if entries_val is None:
            return []
        if isinstance(entries_val, list):
            if not entries_val:
                raise _proto("Access to entries was denied by the user", 6)
            return [Entry.from_dict(v) for v in entries_val]
        raise _proto("entries field is not an array")

    def get_totp(self, uuid: str) -> Optional[str]:
        inner = {"action": "get-totp", "uuid": uuid}
        decrypted = self._send_encrypted("get-totp", inner)
        totp = decrypted.get("totp")
        if isinstance(totp, str) and totp:
            return totp
        return None

    # ----------------------------------------------------------------- write API
    def set_login(self, url: str, username: str, password: str,
                  submit_url: Optional[str] = None,
                  uuid: Optional[str] = None,
                  group: Optional[str] = None,
                  group_uuid: Optional[str] = None,
                  download_favicon: bool = False) -> None:
        inner = {
            "action": "set-login",
            "url": url,
            "login": username,
            "password": password,
            "keys": connection_keys(self.config.associations_iter()),
        }
        if submit_url:
            inner["submitUrl"] = submit_url
        if uuid:
            inner["uuid"] = uuid
        gu = group_uuid or ""
        g = group or ""
        if gu and not g:
            # KeePassXC only runs UUID-based group lookup when "group" is
            # non-empty - supply the UUID as the trigger value.
            inner["group"] = gu
            inner["groupUuid"] = gu
        else:
            if g:
                inner["group"] = g
            if gu:
                inner["groupUuid"] = gu
        if download_favicon:
            inner["downloadFavicon"] = "true"
        self._send_encrypted("set-login", inner)

    def create_group(self, name: str) -> Group:
        inner = {"action": "create-new-group", "groupName": name}
        decrypted = self._send_encrypted("create-new-group", inner)
        return Group(
            uuid=decrypted.get("uuid", "") or "",
            name=decrypted.get("name", name) or name,
            children=[],
        )

    def get_database_groups(self) -> list:
        inner = {"action": "get-database-groups"}
        decrypted = self._send_encrypted("get-database-groups", inner)
        # The server wraps the tree twice: response.groups.groups = [root].
        groups_field = decrypted.get("groups")
        if isinstance(groups_field, dict):
            group_list = groups_field.get("groups", []) or []
        elif isinstance(groups_field, list):
            group_list = groups_field
        else:
            group_list = []
        return [Group.from_dict(v) for v in group_list]

    def get_database_entries(self) -> list:
        inner = {"action": "get-database-entries"}
        try:
            decrypted = self._send_encrypted("get-database-entries", inner)
        except KeePassXCError as exc:
            if exc.error_code == 15:
                return []
            raise
        entries_val = decrypted.get("entries")
        if entries_val is None:
            return []
        if isinstance(entries_val, list):
            return [Entry.from_dict(v) for v in entries_val]
        raise _proto("entries field is not an array")

    def delete_entry(self, uuid: str) -> None:
        inner = {"action": "delete-entry", "uuid": uuid}
        self._send_encrypted("delete-entry", inner)

    def lock_database(self) -> None:
        self._ensure_session()
        nonce = random_nonce()
        inner = {"action": "lock-database"}
        ciphertext = self._encrypt(nonce, inner)
        envelope = {
            "action": "lock-database",
            "message": ciphertext,
            "nonce": encode_bytes(nonce),
        }
        response = self._send_envelope(envelope, self._call_timeout())
        self._assert_no_error(response, "lock-database")


def _extract_error_code(response: dict) -> int:
    """KeePassXC sends errorCode as a JSON *string* (e.g. "15"); also accept int."""
    code = response.get("errorCode")
    if code is None:
        return -1
    if isinstance(code, bool):
        return -1
    if isinstance(code, int):
        return code
    try:
        return int(code)
    except (TypeError, ValueError):
        return -1


# =====================================================================================
# Output formatting (table or JSON)
# =====================================================================================

KPH_PREFIX = "KPH: "


def _normalized_string_fields(entry: Entry, keep_prefix: bool) -> list:
    if keep_prefix:
        return list(entry.string_fields)
    out = []
    for field_obj in entry.string_fields:
        if isinstance(field_obj, dict):
            new = {}
            for k, v in field_obj.items():
                if k.startswith(KPH_PREFIX):
                    new[k[len(KPH_PREFIX):]] = v
                else:
                    new[k] = v
            out.append(new)
        else:
            out.append(field_obj)
    return out


def print_entry_detail(entry: Entry, fmt: str, show_password: bool,
                       show_kph_prefix: bool) -> None:
    if fmt == "json":
        data = {
            "uuid": entry.uuid,
            "name": entry.name,
            "login": entry.login,
            "group": entry.group,
            "group_uuid": entry.group_uuid,
            "string_fields": _normalized_string_fields(entry, show_kph_prefix),
        }
        if show_password:
            data["password"] = entry.password
            if entry.totp:
                data["totp"] = entry.totp
        print(json.dumps(data, indent=2))
        return

    print(f"UUID:       {entry.uuid}")
    print(f"Title:      {entry.name}")
    print(f"Username:   {entry.login}")
    if show_password:
        print(f"Password:   {entry.password}")
    if show_password and entry.totp:
        print(f"TOTP:       {entry.totp}")
    if entry.group:
        print(f"Group:      {entry.group}")
    if entry.group_uuid:
        print(f"Group UUID: {entry.group_uuid}")
    for field_obj in _normalized_string_fields(entry, show_kph_prefix):
        if isinstance(field_obj, dict):
            for k, v in field_obj.items():
                print(f"{k}: {v}")


_ENTRY_FIELDS = {
    "password": "password",
    "username": "login",
    "login": "login",
    "name": "name",
    "title": "name",
    "totp": "totp",
    "uuid": "uuid",
    "group": "group",
    "group-uuid": "group_uuid",
    "groupuuid": "group_uuid",
}


def print_entry_field(entry: Entry, field: str, fmt: str) -> Optional[str]:
    """Print one field's raw value. Returns an error string or None on success."""
    key = field.lower()
    if key not in _ENTRY_FIELDS:
        return (
            f"unknown field: {field!r} (try: password, username, name, totp, "
            "uuid, group, group-uuid)"
        )
    value = getattr(entry, _ENTRY_FIELDS[key], "") or ""
    if fmt == "json":
        print(json.dumps({field: value}))
    else:
        print(value)
    return None


def print_totp(totp: str, fmt: str) -> None:
    if fmt == "json":
        print(json.dumps({"totp": totp}, indent=2))
    else:
        print(totp)


def print_result(message: str, fmt: str) -> None:
    if fmt == "json":
        print(json.dumps({"status": "ok", "message": message}, indent=2))
    else:
        print(message)


def print_status(info: list, fmt: str) -> None:
    if fmt == "json":
        obj = {k: v for k, v in info}
        print(json.dumps(obj, indent=2))
    else:
        for k, v in info:
            print(f"{k}: {v}")


def confirm(prompt: str) -> bool:
    try:
        line = input(prompt + " ")
    except EOFError:
        return False
    return line.strip().lower() in ("y", "yes")


# =====================================================================================
# Clipboard (Win32, no extra dependency)
# =====================================================================================

def copy_to_clipboard(text: str) -> None:
    user32 = ctypes.WinDLL("user32")
    kernel32 = ctypes.WinDLL("kernel32")

    user32.OpenClipboard.argtypes = [wintypes.HWND]
    user32.OpenClipboard.restype = wintypes.BOOL
    user32.EmptyClipboard.argtypes = []
    user32.EmptyClipboard.restype = wintypes.BOOL
    user32.SetClipboardData.argtypes = [wintypes.UINT, wintypes.HANDLE]
    user32.SetClipboardData.restype = wintypes.HANDLE
    user32.CloseClipboard.argtypes = []
    user32.CloseClipboard.restype = wintypes.BOOL

    kernel32.GlobalAlloc.argtypes = [wintypes.UINT, ctypes.c_size_t]
    kernel32.GlobalAlloc.restype = wintypes.HANDLE
    kernel32.GlobalLock.argtypes = [wintypes.HANDLE]
    kernel32.GlobalLock.restype = wintypes.LPVOID
    kernel32.GlobalUnlock.argtypes = [wintypes.HANDLE]
    kernel32.GlobalUnlock.restype = wintypes.BOOL

    GMEM_MOVEABLE = 0x0002
    CF_UNICODETEXT = 13

    if not user32.OpenClipboard(None):
        raise OSError("OpenClipboard failed")
    try:
        user32.EmptyClipboard()
        buf = (text + "\0").encode("utf-16-le")
        h_mem = kernel32.GlobalAlloc(GMEM_MOVEABLE, len(buf))
        if not h_mem:
            raise OSError("GlobalAlloc failed")
        ptr = kernel32.GlobalLock(h_mem)
        if not ptr:
            raise OSError("GlobalLock failed")
        ctypes.memmove(ptr, buf, len(buf))
        kernel32.GlobalUnlock(h_mem)
        user32.SetClipboardData(CF_UNICODETEXT, h_mem)
    finally:
        user32.CloseClipboard()


# =====================================================================================
# Command handlers
# =====================================================================================

def cmd_setup(client, bc, bcp, fmt, args) -> int:
    client.setup()
    client.config.save(bcp)
    print("Successfully associated with KeePassXC.")
    return 0


def cmd_status(client, bc, bcp, fmt, args) -> int:
    info: list = []
    try:
        client.connect()
    except KeePassXCError:
        info.append(("Connected", "no"))
        print_status(info, fmt)
        return 1
    info.append(("Connected", "yes"))

    associated = False
    assoc = bc.first_association()
    if assoc is not None:
        try:
            client.change_public_keys()
            associated = client.test_associate(assoc)
        except KeePassXCError:
            associated = False
    info.append(("Associated", "yes" if associated else "no"))
    info.append(("Unlock timeout", str(bc.unlock_timeout)))

    client.disconnect()
    print_status(info, fmt)
    return 0


def cmd_show(client, bc, bcp, fmt, args) -> int:
    entries = client.get_logins(args.url)
    if not entries:
        sys.stderr.write(f"warning: no entries found for: {args.url}\n")
        return 1

    if args.only:
        for entry in entries:
            err = print_entry_field(entry, args.only, fmt)
            if err:
                sys.stderr.write(err + "\n")
                return 1
        return 0

    multi = len(entries) > 1
    for entry in entries:
        print_entry_detail(entry, fmt, args.show_password, args.show_kph_prefix)
        if fmt != "json" and multi:
            print()
    return 0


def resolve_group_uuid(client: BrowserClient, path: str) -> Optional[str]:
    groups = client.get_database_groups()
    if not groups:
        return None
    root = groups[0]
    current = root.children
    matched = None
    for part in path.split("/"):
        matched = None
        for g in current:
            if g.name == part:
                matched = g
                break
        if matched is None:
            return None
        current = matched.children
    return matched.uuid if matched else None


def cmd_add(client, bc, bcp, fmt, args) -> int:
    if args.password is not None:
        password = args.password
    else:
        try:
            password = getpass.getpass("Password: ")
        except (EOFError, KeyboardInterrupt):
            password = ""

    group_uuid = ""
    if args.group_uuid:
        group_uuid = args.group_uuid
    elif args.group:
        group_uuid = resolve_group_uuid(client, args.group) or ""
        if not group_uuid:
            sys.stderr.write(f"error: group not found: {args.group!r}\n")
            return 1

    client.set_login(
        args.url, args.username, password,
        None, None, None,
        group_uuid or None,
        False,
    )
    print_result("Entry added.", fmt)
    return 0


def _pick_entry(entries: list, uuid: Optional[str]):
    if uuid:
        for e in entries:
            if e.uuid == uuid:
                return e, None
        return None, uuid
    if len(entries) == 1:
        return entries[0], None
    return None, None  # ambiguous


def cmd_edit(client, bc, bcp, fmt, args) -> int:
    entries = client.get_logins(args.url)
    if not entries:
        sys.stderr.write(f"error: no entries found for: {args.url}\n")
        return 1

    entry, missing = _pick_entry(entries, args.uuid)
    if entry is None and missing is not None:
        sys.stderr.write(f"error: entry {missing} not found for URL: {args.url}\n")
        return 1
    if entry is None:
        sys.stderr.write(
            f"error: multiple entries found for {args.url} - "
            "specify --uuid to disambiguate:\n"
        )
        for e in entries:
            print(f"  {e.uuid}  {e.login}  ({e.name})")
        return 1

    new_username = args.username if args.username is not None else entry.login
    new_password = args.password if args.password is not None else entry.password
    client.set_login(
        args.url, new_username, new_password,
        None, entry.uuid, None, entry.group_uuid, False,
    )
    print_result("Entry updated.", fmt)
    return 0


def cmd_rm(client, bc, bcp, fmt, args) -> int:
    entries = client.get_logins(args.url)
    if not entries:
        sys.stderr.write(f"error: no entries found for: {args.url}\n")
        return 1

    entry, missing = _pick_entry(entries, args.uuid)
    if entry is None and missing is not None:
        sys.stderr.write(f"error: entry {missing} not found for URL: {args.url}\n")
        return 1
    if entry is None:
        sys.stderr.write(
            f"error: multiple entries found for {args.url} - "
            "specify --uuid to disambiguate:\n"
        )
        for e in entries:
            print(f"  {e.uuid}  {e.login}  ({e.name})")
        return 1

    label = f"{entry.name} ({args.url})"
    if not args.yes and not confirm(f"Delete entry {label}? [y/N]"):
        print("Aborted.")
        return 1

    client.delete_entry(entry.uuid)
    print_result("Entry deleted.", fmt)
    return 0


def cmd_totp(client, bc, bcp, fmt, args) -> int:
    entries = client.get_logins(args.url)
    if not entries:
        sys.stderr.write(f"warning: no entries found for: {args.url}\n")
        return 1
    entry = entries[0]
    code = client.get_totp(entry.uuid)
    if code:
        print_totp(code, fmt)
        return 0
    sys.stderr.write(f"warning: no TOTP configured for: {entry.name}\n")
    return 1


def cmd_clip(client, bc, bcp, fmt, args) -> int:
    entries = client.get_logins(args.url)
    if not entries:
        sys.stderr.write(f"warning: no entries found for: {args.url}\n")
        return 1
    entry = entries[0]
    field = args.field
    if field == "password":
        value = entry.password
    elif field == "username":
        value = entry.login
    elif field == "totp":
        value = client.get_totp(entry.uuid)
        if not value:
            sys.stderr.write(f"warning: no TOTP configured for: {entry.name}\n")
            return 1
    else:
        sys.stderr.write(f"error: unknown field: {field}\n")
        return 1

    try:
        copy_to_clipboard(value)
    except Exception as exc:
        sys.stderr.write(f"error: could not write to clipboard: {exc}\n")
        return 1
    print(f"Copied {field} to clipboard.")
    return 0


def cmd_lock(client, bc, bcp, fmt, args) -> int:
    try:
        client.lock_database()
    except KeePassXCError as exc:
        sys.stderr.write(f"error: failed to lock database: {exc}\n")
        return 1
    print_result("Database locked.", fmt)
    return 0


def cmd_unlock(client, bc, bcp, fmt, args) -> int:
    client.ensure_unlocked()
    print_result("Database unlocked.", fmt)
    return 0


def cmd_mkdir(client, bc, bcp, fmt, args) -> int:
    group = client.create_group(args.name)
    if fmt == "json":
        print(json.dumps({"name": group.name, "uuid": group.uuid}, indent=2))
    else:
        print(f"Group created: {group.name} [{group.uuid}]")
    return 0


def cmd_group_uuid(client, bc, bcp, fmt, args) -> int:
    groups = client.get_database_groups()
    if not groups:
        sys.stderr.write("error: database returned no root group\n")
        return 1
    root = groups[0]
    current = root.children
    matched = None
    for part in args.path.split("/"):
        matched = None
        for g in current:
            if g.name == part:
                matched = g
                break
        if matched is None:
            sys.stderr.write(f"error: group not found: {args.path!r}\n")
            return 1
        current = matched.children

    if fmt == "json":
        print(json.dumps(
            {"path": args.path, "name": matched.name, "uuid": matched.uuid}, indent=2
        ))
    else:
        print(f"{args.path} [{matched.uuid}]")
    return 0


def _find_group_by_path(root: Group, target: str) -> Optional[Group]:
    segments = [s.strip() for s in target.split("/") if s.strip()]
    if not segments:
        return None
    return _find_in_children(root, segments)


def _find_in_children(node: Group, segments: list) -> Optional[Group]:
    if not segments:
        return node
    head = segments[0]
    for child in node.children:
        if child.name.lower() == head.lower():
            found = _find_in_children(child, segments[1:])
            if found is not None:
                return found
    return None


def _path_leaf(path: str) -> str:
    return path.rsplit("/", 1)[-1] if "/" in path else path


def _collect_paths(node: Group, prefix: str) -> list:
    out = []
    for child in node.children:
        path = child.name if not prefix else f"{prefix}/{child.name}"
        out.append((path, child))
        out.extend(_collect_paths(child, path))
    return out


def _list_groups_fallback(client: BrowserClient, fmt: str,
                          filter_path: Optional[str]) -> int:
    groups = client.get_database_groups()
    if not groups:
        sys.stderr.write("warning: no groups returned\n")
        return 1
    root = groups[0]
    if filter_path:
        start = _find_group_by_path(root, filter_path)
        if start is None:
            sys.stderr.write(f"warning: group not found: {filter_path}\n")
            return 1
    else:
        start = root

    if fmt == "json":
        paths = [p for p, _ in _collect_paths(start, "")]
        if filter_path:
            paths.insert(0, _path_leaf(filter_path))
        print(json.dumps(paths))
    else:
        if filter_path:
            print(f"{start.uuid}  {_path_leaf(filter_path)}")
        for path, group in _collect_paths(start, ""):
            print(f"{group.uuid}  {path}")
    return 0


def cmd_list(client, bc, bcp, fmt, args) -> int:
    filter_uuid: Optional[str] = args.group if args.uuid else None
    group_path_filter: Optional[str] = None

    if (not args.uuid) and args.group:
        group_path_filter = args.group
        groups = client.get_database_groups()
        if groups:
            root = groups[0]
            g = _find_group_by_path(root, args.group)
            if g is not None:
                filter_uuid = g.uuid
            else:
                sys.stderr.write(f"warning: group not found: {args.group}\n")
                return 1

    try:
        entries = client.get_database_entries()
    except KeePassXCError as exc:
        if exc.error_code in (12, 19):
            sys.stderr.write(
                f"warning: KeePassXC does not support listing all entries "
                f"(code {exc.error_code}).\n"
            )
            sys.stderr.write(
                "warning: falling back to group listing. Use `show <url>` for entries.\n"
            )
            return _list_groups_fallback(client, fmt, group_path_filter)
        raise

    if filter_uuid:
        entries = [e for e in entries if e.group_uuid.lower() == filter_uuid.lower()]

    if not entries:
        if fmt == "json":
            print("[]")
        else:
            sys.stderr.write("warning: no entries found\n")
        return 1

    multi = len(entries) > 1
    for entry in entries:
        # get-database-entries never returns passwords.
        print_entry_detail(entry, fmt, False, args.show_kph_prefix)
        if fmt != "json" and multi:
            print()
    return 0


VERSION = "0.1.0"

EXIT_CODES_TABLE = [
    (0, "SUCCESS", "Command completed successfully"),
    (1, "ERROR", "Generic or unexpected error"),
    (2, "CONNECTION_ERROR",
     "Could not connect to KeePassXC (not running or pipe missing)"),
    (3, "DATABASE_LOCKED", "KeePassXC database is locked"),
    (4, "ACCESS_DENIED", "KeePassXC denied access to entries"),
]


def cmd_version(client, bc, bcp, fmt, args) -> int:
    if fmt == "json":
        print(json.dumps({"version": VERSION}, indent=2))
    else:
        print(f"kpxc-cli {VERSION}")
    return 0


def cmd_exit_codes(client, bc, bcp, fmt, args) -> int:
    if fmt == "json":
        arr = [{"code": c, "name": n, "description": d}
               for c, n, d in EXIT_CODES_TABLE]
        print(json.dumps(arr, indent=2))
    else:
        name_w = max(len(n) for _, n, _ in EXIT_CODES_TABLE)
        print(f"{'CODE':<6}  {'NAME':<{name_w}}  DESCRIPTION")
        print(f"{'':-<6}  {'':-<{name_w}}  {'':-<40}")
        for code, name, desc in EXIT_CODES_TABLE:
            print(f"{code:<6}  {name:<{name_w}}  {desc}")
    return 0


COMMANDS = {
    "setup": cmd_setup,
    "status": cmd_status,
    "show": cmd_show,
    "add": cmd_add,
    "edit": cmd_edit,
    "rm": cmd_rm,
    "totp": cmd_totp,
    "clip": cmd_clip,
    "lock": cmd_lock,
    "unlock": cmd_unlock,
    "mkdir": cmd_mkdir,
    "group-uuid": cmd_group_uuid,
    "list": cmd_list,
    "version": cmd_version,
    "exit-codes": cmd_exit_codes,
}


# =====================================================================================
# CLI (argparse) - mirrors the Rust clap layout
# =====================================================================================

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="kpxc-cli",
        description=(
            "CLI for KeePassXC using the browser extension protocol "
            "(Windows named pipe). A Python port of the Rust kpxc-cli."
        ),
    )
    parser.add_argument("--config", default="",
                        help="Path to the CLI config file.")
    parser.add_argument("--browser-api-config", default=None,
                        help="Path to the browser API config file (holds association keys).")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="Enable verbose / debug logging on stderr.")

    sub = parser.add_subparsers(dest="command", required=True, metavar="<command>")

    sub.add_parser("setup",
                   help="Associate with KeePassXC (first-time key exchange).")

    p = sub.add_parser("status", help="Show connection and association status.")
    p.add_argument("-j", "--json", action="store_true", help="Output as JSON.")

    p = sub.add_parser("show", help="Show entries matching a URL.")
    p.add_argument("url", help="URL or search string.")
    p.add_argument("-p", "--show-password", action="store_true",
                   help="Reveal password and TOTP in the output.")
    p.add_argument("--show-kph-prefix", action="store_true",
                   help="Keep the `KPH: ` prefix on custom string-field names.")
    p.add_argument("-o", "--only", default=None, metavar="FIELD",
                   help="Print only a single field's raw value "
                        "(password, username, name, totp, uuid, group, group-uuid).")
    p.add_argument("-j", "--json", action="store_true", help="Output as JSON.")

    p = sub.add_parser("add", help="Add a new entry.")
    p.add_argument("url", help="Entry URL.")
    p.add_argument("username", help="Username.")
    p.add_argument("--password", default=None, help="Password (prompted securely if omitted).")
    p.add_argument("--group-uuid", default=None, help="Target group UUID.")
    p.add_argument("--group", default=None, help="Target group path, e.g. Work/Projects.")
    p.add_argument("-j", "--json", action="store_true", help="Output as JSON.")

    p = sub.add_parser("edit", help="Edit an existing entry.")
    p.add_argument("url", help="URL of the entry.")
    p.add_argument("--uuid", default=None, help="Entry UUID (required when URL matches multiple).")
    p.add_argument("--username", default=None, help="New username.")
    p.add_argument("--password", default=None, help="New password.")
    p.add_argument("-j", "--json", action="store_true", help="Output as JSON.")

    p = sub.add_parser("rm", help="Delete an entry.")
    p.add_argument("url", help="URL of the entry to delete.")
    p.add_argument("--uuid", default=None, help="UUID to disambiguate when URL matches multiple.")
    p.add_argument("-y", "--yes", action="store_true", help="Skip the confirmation prompt.")
    p.add_argument("-j", "--json", action="store_true", help="Output as JSON.")

    p = sub.add_parser("totp", help="Get the current TOTP code for an entry.")
    p.add_argument("url", help="URL to look up.")
    p.add_argument("-j", "--json", action="store_true", help="Output as JSON.")

    p = sub.add_parser("clip", help="Copy a field to the clipboard.")
    p.add_argument("url", help="URL to look up.")
    p.add_argument("field", help="Field to copy: password, username, or totp.")

    p = sub.add_parser("lock", help="Lock the KeePassXC database.")
    p.add_argument("-j", "--json", action="store_true", help="Output as JSON.")

    p = sub.add_parser("unlock", help="Unlock the KeePassXC database (triggers Windows Hello).")
    p.add_argument("-j", "--json", action="store_true", help="Output as JSON.")

    p = sub.add_parser("mkdir", help="Create a new group.")
    p.add_argument("name", help="Group name or path. Use / to nest (e.g. Work/Projects).")
    p.add_argument("-j", "--json", action="store_true", help="Output as JSON.")

    p = sub.add_parser("group-uuid", help="Look up a group's UUID by path.")
    p.add_argument("path", help="Group path relative to the database root.")
    p.add_argument("-j", "--json", action="store_true", help="Output as JSON.")

    p = sub.add_parser("list", help="List entries in the database, optionally filtered by group.")
    p.add_argument("group", nargs="?", default="",
                   help="Group path (e.g. Work/Projects) or, with --uuid, a group UUID.")
    p.add_argument("--uuid", action="store_true", help="Treat `group` as a UUID instead of a path.")
    p.add_argument("--show-kph-prefix", action="store_true",
                   help="Keep the `KPH: ` prefix on custom string-field names.")
    p.add_argument("-j", "--json", action="store_true", help="Output as JSON.")

    p = sub.add_parser("version", help="Print the kpxc-cli version.")
    p.add_argument("-j", "--json", action="store_true", help="Output as JSON.")

    p = sub.add_parser("exit-codes", help="Print the documented exit codes.")
    p.add_argument("-j", "--json", action="store_true", help="Output as JSON.")

    return parser


def format_for(args: argparse.Namespace, cli_default: str) -> str:
    """Resolve the output format for the chosen subcommand."""
    if args.command in ("setup", "clip"):
        return cli_default
    return "json" if getattr(args, "json", False) else cli_default


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.verbose:
        sys.stderr.write("[debug] verbose logging enabled\n")

    # ---- Load configs ----
    cli_config_path = Path(args.config) if args.config else default_cli_config_path()
    cli_config = CliConfig.load(cli_config_path)

    if args.browser_api_config:
        browser_config_path = Path(args.browser_api_config)
    else:
        browser_config_path = cli_config.browser_api_config_path_effective()

    browser_config = BrowserConfig.load(browser_config_path)
    fmt = format_for(args, cli_config.default_format_effective())

    # ---- Build client ----
    try:
        client = BrowserClient(browser_config)
    except KeePassXCError as exc:
        sys.stderr.write(f"error: {exc}\n")
        return exc.exit_code()
    # The client may have generated fresh keys; browser_config is the same
    # object the client mutated, so nothing to reassign.

    # ---- Dispatch ----
    try:
        rc = COMMANDS[args.command](client, client.config, browser_config_path, fmt, args)
    except KeePassXCError as exc:
        sys.stderr.write(f"error: {exc}\n")
        rc = exc.exit_code()

    # Always persist the client's authoritative copy of the config - it may
    # have generated fresh NaCl keys or stored a new association.
    try:
        client.config.save(browser_config_path)
    except OSError:
        pass

    return rc


if __name__ == "__main__":
    sys.exit(main())
