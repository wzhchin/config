# Chin prompt theme

# Reference:
#     Overall: http://zsh.sourceforge.net/Doc/Release/Shell-Builtin-Commands.html
#     zsh/zselect: http://zsh.sourceforge.net/Doc/Release/Zsh-Modules.html#The-zsh_002fzselect-Module
#     coproc: https://unix.stackexchange.com/questions/86270/how-do-you-use-the-command-coproc-in-various-shells
#             https://www.zsh.org/mla/users/2011/msg00095.html

# Thanks to: https://github.com/ericfreese/zsh-efgit-prompt/blob/master/prompt_efgit_setup

## Extended prompt part: git
_prompt_chin_count_git_commands() {
    local file="$1"
    local line
    local -i count=0

    if [[ -r "$file" ]]; then
        while IFS= read -r line; do
            [[ -n "$line" && "$line" != \#* ]] && (( count++ ))
        done < "$file"
    fi

    REPLY="$count"
}

_prompt_chin_git_operation() {
    local gdir="$1"
    local operation="" current="" total=""
    local -i done_count=0 todo_count=0

    if [[ -d "$gdir/rebase-merge" ]]; then
        [[ -r "$gdir/rebase-merge/msgnum" ]] && current="$(<"$gdir/rebase-merge/msgnum")"
        [[ -r "$gdir/rebase-merge/end" ]] && total="$(<"$gdir/rebase-merge/end")"
        operation="REBASE"
    elif [[ -d "$gdir/rebase-apply" ]]; then
        [[ -r "$gdir/rebase-apply/next" ]] && current="$(<"$gdir/rebase-apply/next")"
        [[ -r "$gdir/rebase-apply/last" ]] && total="$(<"$gdir/rebase-apply/last")"
        operation="REBASE"
    elif [[ -f "$gdir/MERGE_HEAD" ]]; then
        operation="MERGING"
    elif [[ -f "$gdir/CHERRY_PICK_HEAD" ]]; then
        operation="CHERRY-PICK"
    elif [[ -f "$gdir/REVERT_HEAD" ]]; then
        operation="REVERT"
    elif [[ -f "$gdir/BISECT_LOG" ]]; then
        operation="BISECT"
    fi

    if [[ "$operation" == "CHERRY-PICK" || "$operation" == "REVERT" ]]; then
        _prompt_chin_count_git_commands "$gdir/sequencer/done"
        done_count="$REPLY"
        _prompt_chin_count_git_commands "$gdir/sequencer/todo"
        todo_count="$REPLY"

        if (( done_count + todo_count > 1 )); then
            current=$(( done_count + 1 ))
            total=$(( done_count + todo_count ))
        fi
    fi

    if [[ -n "$current" && -n "$total" ]]; then
        operation+=" ${current}/${total}"
    fi

    REPLY="$operation"
}

prompt_chin_git_status() {
    local -a repo_info
    repo_info=(${(f)"$(git rev-parse --absolute-git-dir --verify HEAD 2>&-)"})

    local gdir="$repo_info[1]"
    local ref_oid="$repo_info[2]"

    [[ -n "$gdir" ]] || {
        print $'\0'
        return
    }

    local -a parts
    local fd refs_fd line operation state head oid upstream xy submodule
    local ref_line ref_name upstream_track
    local -i ahead=0 behind=0 conflicts=0 staged=0 changed=0 untracked=0
    local -i stash_count=0 submodules=0 has_upstream_ab=0 upstream_gone=0

    _prompt_chin_git_operation "$gdir"
    operation="$REPLY"
    [[ -n "$operation" ]] && operation+="|"

    if [[ -n "$ref_oid" ]]; then
        exec {refs_fd}< <(
            git for-each-ref \
                --format='%(refname)%09%(upstream:track)' \
                --points-at "$ref_oid" \
                refs/heads/ \
                refs/tags/ \
                2>/dev/null
        )
    fi

    exec {fd}< <(
        GIT_OPTIONAL_LOCKS=0 git status \
            --porcelain=v2 \
            --branch \
            --show-stash \
            2>&-
    )

    while read -A -u "$fd" line; do
        case "$line" in
            '# branch.oid'*)
                oid="$line[3]"
                ;;
            '# branch.head'*)
                head="$line[3]"
                ;;
            '# branch.upstream'*)
                upstream="$line[3]"
                ;;
            '# branch.ab'*) # Divergence from upstream
                ahead="${line[3]/#+}"
                behind="${line[4]/#-}"
                has_upstream_ab=1
                ;;
            '# stash'*)
                stash_count="$line[3]"
                ;;
            [12]*) # Modified or renamed/copied
                xy="$line[2]"
                submodule="$line[3]"
                [[ "${xy[1]}" != "." ]] && (( staged++ ))
                [[ "${xy[2]}" != "." ]] && (( changed++ ))
                [[ "$submodule" == S* ]] && (( submodules++ ))
                ;;
            'u'*) # Unmerged
                (( conflicts++ ))
                ;;
            '?'*) # Untracked
                (( untracked++ ))
                ;;
        esac
    done

    exec {fd}<&-

    if [[ "$oid" == "(initial)" ]]; then
        state="INITIAL|"
    elif [[ "$head" == "(detached)" ]]; then
        local operation_head=""
        if [[ "$operation" == REBASE* ]]; then
            if [[ -r "$gdir/rebase-merge/head-name" ]]; then
                operation_head="$(<"$gdir/rebase-merge/head-name")"
            elif [[ -r "$gdir/rebase-apply/head-name" ]]; then
                operation_head="$(<"$gdir/rebase-apply/head-name")"
            fi
        fi

        if [[ "$operation_head" == refs/heads/* ]]; then
            head="${operation_head#refs/heads/}"
        else
            head="@${oid[1,7]}"
        fi
    fi

    local -a tags
    if [[ -n "$refs_fd" ]]; then
        while IFS= read -r -u "$refs_fd" ref_line; do
            ref_name="${ref_line%%$'\t'*}"
            upstream_track="${ref_line#*$'\t'}"

            if [[ "$ref_name" == refs/tags/* ]]; then
                tags+="${ref_name#refs/tags/}"
            elif [[ "$ref_name" == "refs/heads/$head" && "$upstream_track" == "[gone]" ]]; then
                upstream_gone=1
            fi
        done
        exec {refs_fd}<&-
    fi

    head="${head//\%/%%}"
    local -i tag_index
    for (( tag_index = 1; tag_index <= $#tags; tag_index++ )); do
        tags[$tag_index]="${tags[$tag_index]//\%/%%}"
    done
    (( $#tags )) && head+=" ${(j:,:)tags}"

    parts+="%F{red}${operation}${state}"
    (( stash_count )) && parts+="SH${stash_count}|"
    parts+="%f"

    parts+="${head}"

    local -a upstream_divergence

    if (( upstream_gone )) || { [[ -n "$upstream" ]] && (( ! has_upstream_ab )); }; then
        upstream_divergence+=" %F{red}GONE%f"
    else
        (( ahead )) && upstream_divergence+=" %F{90}A$ahead%f"
        (( behind )) && upstream_divergence+=" %F{90}B$behind%f"
    fi
    (( $#upstream_divergence )) && parts+="${(j::)upstream_divergence}"

    local -a working_info

    (( conflicts )) && working_info+=" %F{red}x$conflicts%f"
    (( staged )) && working_info+=" %F{green}=$staged%f"
    (( changed )) && working_info+=" %F{208}*$changed%f"
    (( untracked )) && working_info+=" %F{red}+$untracked%f"
    (( submodules )) && working_info+=" %F{cyan}S$submodules%f"
    parts+="${(j::)working_info}"

    print -rn -- "(${(j::)parts})"
}

prompt_chin_git_assemble() {
    local prompt_chin_git_status="$(<&$1)"
    [ -n "$prompt_chin_git_status" ] || return
    PROMPT="${PROMPT_CHIN_HEAD} ${prompt_chin_git_status}${PROMPT_CHIN_TAIL}"
    zle reset-prompt

    zle -F $1
    exec {1}<&-
}


prompt_chin_extend() {
    typeset -g PROMPT_CHIN_GIT_FD

    # Close previous fd
    if [[ -n $PROMPT_CHIN_GIT_FD ]] && { true <&$PROMPT_CHIN_GIT_FD } 2>/dev/null; then
        exec {PROMPT_CHIN_GIT_FD}<&-
        zle -F $PROMPT_CHIN_GIT_FD
    fi

    exec {PROMPT_CHIN_GIT_FD}< <(prompt_chin_git_status)
    zle -F $PROMPT_CHIN_GIT_FD prompt_chin_git_assemble
}

prompt_chin_precmd() {
    typeset -g PROMPT_CHIN_HEAD PROMPT_CHIN_TAIL

    local cost_time=""
    if [[ -v PROMPT_CHIN_LAST_TIME ]]; then
      cost_time=$(($SECONDS - $PROMPT_CHIN_LAST_TIME))
      (( cost_time > 10 )) && cost_time=" [%F{red}%D{%H:%M:%S}~${cost_time}s%f]" || cost_time=""
    fi

    unset PROMPT_CHIN_LAST_TIME

    local histsignal
    [ -z "$HISTFILE" ] && histsignal+="H- "

    PROMPT_CHIN_HEAD="%(?..%F{red}[%?]%f )${}${histsignal}%(1j.%F{cyan}(%j)%f .)%B%F{yellow}%n%f%b@%B%F{blue}%m%f%b %B%F{green}%~%f%b${cost_time}"

    local -a environment_status
    [[ -n "${VIRTUAL_ENV}" ]] && environment_status+="%F{cyan}(${VIRTUAL_ENV:t})%f"
    [[ -n "$HTTP_PROXY" ]] && environment_status+="%F{yellow}HPX%f"

    local environment_line=""
    (( $#environment_status )) && environment_line="${prompt_newline}${(j: :)environment_status}"

    PROMPT_CHIN_TAIL="${environment_line}${prompt_newline}%F{red}%(!,%K{red}#%k,$) %b%f%k"

    local git_placeholder=""
    if git rev-parse --git-dir &>/dev/null; then
        git_placeholder=" %F{90}(...)%f"
    fi

    PROMPT="${PROMPT_CHIN_HEAD}${git_placeholder}${PROMPT_CHIN_TAIL}"

    prompt_chin_extend
}

prompt_chin_preexec() {
    typeset -g PROMPT_CHIN_LAST_TIME
    PROMPT_CHIN_LAST_TIME=$SECONDS
}

add-zsh-hook precmd prompt_chin_precmd
add-zsh-hook preexec prompt_chin_preexec
