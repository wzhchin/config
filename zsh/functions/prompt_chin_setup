# Chin prompt theme

# Reference:
#     Overall: http://zsh.sourceforge.net/Doc/Release/Shell-Builtin-Commands.html
#     zsh/zselect: http://zsh.sourceforge.net/Doc/Release/Zsh-Modules.html#The-zsh_002fzselect-Module
#     coproc: https://unix.stackexchange.com/questions/86270/how-do-you-use-the-command-coproc-in-various-shells
#             https://www.zsh.org/mla/users/2011/msg00095.html

# Thanks to: https://github.com/ericfreese/zsh-efgit-prompt/blob/master/prompt_efgit_setup

typeset -g _PROMPT_CHIN_GIT_COMPLETED=0
typeset -g _PROMPT_CHIN_GIT_COMPLETED_PWD=""


## Extended prompt part: git
prompt_chin_git_status() {
    local gdir="$(git rev-parse --git-dir 2>&-)"

    [[ -n "$gdir" ]] || {
        print $'\0'
        return
    }

    local -a parts
    local fd line operation stashp head ahead behind conflicts staged changed untracked

    if [ -d "$gdir/rebase-apply" ] || [ -d "$gdir/rebase-merge" ]; then
        operation="REBASE|"
    elif [ -f "$gdir/MERGE_HEAD" ]; then
        operation="MERGING|"
    elif test -f "$gdir/CHERRY_PICK_HEAD"; then
        operation="CHERRY-PICK|"
    elif test -f "$gdir/REVERT_HEAD"; then
        operation="REVERT|"
    elif [ -f "$gdir/BISECT_LOG" ]; then
        operation="BISECT|"
    fi

    if [ -f "$gdir/refs/stash" ]; then
        stashp="SH|"
    fi

    parts+="%F{red}${operation}${stashp}%f"


    exec {fd}< <(GIT_OPTIONAL_LOCKS=0 git status --porcelain=v2 --branch 2>&-)

    while read -A -u $fd line; do
        case "$line" in
            '# branch.head'*)
                head="$line[3]"
                ;;
            '# branch.ab'*) # Divergence from upstream
                ahead="${line[3]/#+}"
                behind="${line[4]/#-}"
                ;;
            [12]*) # Modified or renamed/copied
                [[ "${${line[2]}[1]}" != "." ]] && ((staged++))
                [[ "${${line[2]}[2]}" != "." ]] && ((changed++))
                ;;
            'u'*) # Unmerged
                ((conflicts++))
                ;;
            '?'*) # Untracked
                ((untracked++))
                ;;
        esac
    done

    exec {fd}<&-

    if [[ $head == "(detached)" ]]; then
        head="$(git rev-parse --short HEAD 2>/dev/null)"
    fi
    local -a tags
    tags=(${(f)"$(git for-each-ref --format='%(refname:short)' --points-at HEAD refs/tags/ 2>/dev/null)"})
    (( $#tags )) && head+=" ${(j:,:)tags}"

    parts+="${head}"

    local -a upstream_divergence

    (( ahead )) && upstream_divergence+=" %F{90}A$ahead%f"
    (( behind )) && upstream_divergence+=" %F{90}B$behind%f"
    (( $#upstream_divergence )) && parts+="${(j::)upstream_divergence}"

    local -a working_info

    (( conflicts )) && working_info+=" %F{red}x$conflicts%f"
    (( staged )) && working_info+=" %F{green}=$staged%f"
    (( changed )) && working_info+=" %F{208}*$changed%f"
    (( untracked )) && working_info+=" %F{red}+$untracked%f"
    parts+="${(j::)working_info}"

    echo -n "g[${(j::)parts}]"
}

prompt_chin_git_assemble() {
    typeset -g PROMPT_CHIN_GIT_STATUS

    PROMPT_CHIN_GIT_STATUS="$(<&$1)"
    [ -n "$PROMPT_CHIN_GIT_STATUS" ] || return
    PROMPT="${PROMPT_CHIN_HEAD} ${PROMPT_CHIN_GIT_STATUS}${PROMPT_CHIN_TAIL}"
    zle reset-prompt

    zle -F $1
    exec {1}<&-

    _PROMPT_CHIN_GIT_COMPLETED=$SECONDS
    _PROMPT_CHIN_GIT_COMPLETED_PWD="$PWD"
}


prompt_chin_extend() {
    typeset -g PROMPT_CHIN_GIT_FD

    if [[ "$PWD" == "$_PROMPT_CHIN_GIT_COMPLETED_PWD" ]] && \
       (( SECONDS - _PROMPT_CHIN_GIT_COMPLETED < 2 )) && \
       [[ -n "$PROMPT_CHIN_GIT_STATUS" ]]; then
        PROMPT="${PROMPT_CHIN_HEAD} ${PROMPT_CHIN_GIT_STATUS}${PROMPT_CHIN_TAIL}"
        return
    fi

    # Close previous fd
    if [[ -n $PROMPT_CHIN_GIT_FD ]] && { true <&$PROMPT_CHIN_GIT_FD } 2>/dev/null; then
        exec {PROMPT_CHIN_GIT_FD}<&-
        zle -F $PROMPT_CHIN_GIT_FD
    fi

    exec {PROMPT_CHIN_GIT_FD}< <(prompt_chin_git_status)
    zle -F $PROMPT_CHIN_GIT_FD prompt_chin_git_assemble
}

prompt_chin_precmd() {
    typeset -g PROMPT_CHIN_HEAD PROMPT_CHIN_TAIL

    local cost_time=""
    if [[ -v PROMPT_CHIN_LAST_TIME ]]; then
      cost_time=$(($SECONDS - $PROMPT_CHIN_LAST_TIME))
      (( cost_time > 10 )) && cost_time=" [%F{red}%D{%H:%M:%S}~${cost_time}s%f]" || cost_time=""
    fi

    unset PROMPT_CHIN_LAST_TIME

    local -a head_prefix
    [[ -n "$SHPOOL_SESSION_NAME" ]] && head_prefix+="%F{magenta}$SHPOOL_SESSION_NAME%f,"
    [[ -n "$VIRTUAL_ENV_PROMPT" ]] && head_prefix+="%F{35}${VIRTUAL_ENV_PROMPT:t}%f,"
    [ -z "$HISTFILE" ] && head_prefix+="??,"
    local prefix="${(j::)head_prefix}"

    PROMPT_CHIN_HEAD="${prefix}%(?..%F{red}[%?]%f )%(1j.%F{cyan}(%j)%f .)%B%F{yellow}%n%f%b@%B%F{blue}%m%f%b %B%F{green}%~%f%b${cost_time}"

    local tail_his=""
    PROMPT_CHIN_TAIL="${prompt_newline}${tail_his}%F{red}%(!,%K{red}#%k,$) %b%f%k"

    PROMPT="${PROMPT_CHIN_HEAD}${PROMPT_CHIN_TAIL}"

    prompt_chin_extend
}

prompt_chin_preexec() {
    typeset -g PROMPT_CHIN_LAST_TIME
    PROMPT_CHIN_LAST_TIME=$SECONDS
}

add-zsh-hook precmd prompt_chin_precmd
add-zsh-hook preexec prompt_chin_preexec
