# Maintainer: chin
# 基于 Arch 官方 emacs PKGBUILD，精简为单包终端版 + 裁剪。
#
# 与官方 emacs-nox 的差异：
#   1) 只构建 nox 变体，去掉 emacs(GUI) / emacs-wayland。
#   2) package() 阶段裁剪不需要的大块：org/gnus/mail/play/cedet 等
#      （这些是 autoload 按需加载，删掉只省磁盘不省启动，但符合最小化目标）。
#   3) 重建 loaddefs.el，避免删目录后 M-x 报指向已删文件的警告。
#
# 注：emacs 31 起源码已内置 tree-sitter 0.26 兼容 + query 谓词改名
#     （upstream commit d587ce8c / b0143530），故 30.2 时代用的两个
#     补丁不再需要，已移除。
#
# 源：pretest（31.0.90），由 Sean Whitton (Emacs 31 release manager) 签名。

pkgname=emacs-nox-minimal
pkgver=31.0.90
pkgrel=1
pkgdesc='GNU Emacs without X11, trimmed for terminal + vim-style use (no org/gnus/mail)'
arch=('x86_64')
url='https://www.gnu.org/software/emacs/emacs.html'
license=(GPL-3.0-or-later)

depends=(
  gmp
  gnutls
  hicolor-icon-theme
  libacl.so
  libgpm.so
  libncursesw.so
  libsystemd.so
  libtree-sitter.so
  libxml2.so
  zlib
)
# libgccjit 仅用于 native compilation，下面已 --without-native-compilation，
# 故 build/运行时都不再依赖它。

# 关掉 debug 包：默认 OPTIONS=(debug) 会额外产 emacs-nox-minimal-debug（~13M，
# 含 DWARF + 拆分 .debug）。终端自用无需调试符号，省构建时间 + 磁盘。
options=(!debug)

# 注意：program-suffix 留空 → 二进制仍叫 emacs（provides/conflicts 官方 emacs-nox）。
# 若想与官方 emacs-nox 共存，加 --program-suffix=-minimal 并改 provides/conflicts。

source=(
  https://alpha.gnu.org/gnu/emacs/pretest/emacs-${pkgver}.tar.gz{,.sig}
)
b2sums=('980a51c7d7621b2a0fe174ee083e744245f8b66ef459e76aee92b7cec39cf65918fe6ecc1a7df3db044c75ff5242cd6fed9ff158b472e67bfec6d326cff1d8e5'
        '0bb4f3e25a6d8a4ad7a2ad80432fa9c2c818a1605099399fcf7259bc9502ec492ad5138db66ccc85babe861c19ac45b10c8ac5d86155f4639dbd6787637944a8')
validpgpkeys=('17E90D521672C04631B1183EE78DAE0F3115E06B'  # Eli Zaretskii <eliz@gnu.org>
              'CEA1DE21AB108493CC9C65742E82323B8F4353EE'  # Stefan Kangas <stefankangas@gmail.com>
              '0F56D0553B6D411BB695B7AE4BF066240')       # Sean Whitton <spwhitton@spwhitton.name> (Emacs 31)

build() {
  cd emacs-${pkgver}

  # ccache（可选加速器）：emacs 源码量大，重复构建（改 pkgrel/调 configure flag）
  # 命中缓存可省去绝大部分 .o 重编。未装 ccache 时静默跳过，故不进 makedepends。
  # CC/CXX 仅在前面包一层 ccache，底层仍沿用 makepkg 的编译器选择。
  if command -v ccache >/dev/null 2>&1; then
    export CC="ccache ${CC:-gcc}"
    export CXX="ccache ${CXX:-g++}"
  fi

  local _confflags=(
    --sysconfdir=/etc
    --prefix=/usr
    --libexecdir=/usr/lib
    --localstatedir=/var
    --disable-build-details
    --with-modules
    --with-tree-sitter
    --without-x        # 终端用，砍掉整个 X11/GTK 栈
    --without-sound    # 终端无声卡
    # 显式关掉 native compilation（--with-native-compilation）。它会用 libgccjit
    # 把 1500+ 个 elisp aot 成 .eln 机器码，单这一步就占整个构建 ~1 小时，且
    # ccache 对 .eln 无效、每次改 pkgrel 重打包都要重编。终端 minimal 场景
    # 不需要 elisp 原生速度，关掉换构建从 ~1.5h → 几分钟。
    --without-native-compilation
  )

  ./configure "${_confflags[@]}"
  make
}

package() {
  cd emacs-${pkgver}
  make DESTDIR="${pkgdir}" install

  # emacs 31 起上游不再单独安装 ctags（只装 etags），故无需再
  # 重命名 ctags→ctags.emacs 以避让独立 ctags 包。30.2 时代的两行 mv 已删除。

  # fix user/root permissions on usr/share files
  chown -R root:root "${pkgdir}/usr/share/emacs/${pkgver}"

  # ============================================================
  # 裁剪：configure 无法去掉这些纯 Elisp 目录，在此手动删。
  # 它们都是 autoload 按需加载 —— 删掉只省磁盘，不影响启动/核心编辑。
  # ============================================================
  local lisp="${pkgdir}/usr/share/emacs/${pkgver}/lisp"
  rm -rf "$lisp/gnus"      # 邮件/新闻阅读器
  rm -rf "$lisp/mh-e"      # mh 邮件
  rm -rf "$lisp/erc"       # IRC 客户端
  rm -rf "$lisp/cedet"     # 旧 IDE 引擎栈（已被 treesit+eglot 取代）
  rm -rf "$lisp/play"      # 内置游戏
  rm -rf "$lisp/obsolete"  # 已废弃模式
  rm -rf "$lisp/leim"      # 内置输入法(quail)+日文词典 17M
                          # 终端用 fcitx5 输入中文，从不碰 emacs quail。
                          # 中文文件读写不受影响（靠 international/language/charsets）。

  # etc 资源：终端用不到的图片/速查卡/教程/历史日志
  local etc="${pkgdir}/usr/share/emacs/${pkgver}/etc"
  rm -rf "$etc/images"
  rm -rf "$etc/refcards"
  rm -rf "$etc/tutorials"
  rm -f "$etc"/NEWS.*      # 老版本变更日志(NEWS.18~29 等)约 2M，纯文档

  # 注：不重建 loaddefs.el。删掉的 org/gnus 等目录在 loaddefs 里
  # 仍有 autoload 条目，但它们只在用户主动 M-x 对应命令时才触发加载，
  # 平时不会执行，也无启动开销（与官方 emacs-nox 行为一致）。
  # 重建反而会因 generated-autoload-file 是 lexical 变量而在 batch 下报错。
}
