# Maintainer: chin
# 基于 Arch 官方 emacs PKGBUILD，精简为单包终端版 + 裁剪。
#
# 与官方 emacs-nox 的差异：
#   1) 只构建 nox 变体，去掉 emacs(GUI) / emacs-wayland。
#   2) 保留官方两个 tree-sitter 0.26 兼容补丁（解决编译报错）。
#   3) package() 阶段裁剪不需要的大块：org/gnus/mail/play/cedet 等
#      （这些是 autoload 按需加载，删掉只省磁盘不省启动，但符合最小化目标）。
#   4) 重建 loaddefs.el，避免删目录后 M-x 报指向已删文件的警告。
#
# 官方补丁出处：
#   01: https://bugs.gentoo.org/970856 (upstream commit d587ce8c)
#   02: https://bugs.gentoo.org/971731 (upstream commit b0143530)

pkgname=emacs-nox-minimal
pkgver=30.2
pkgrel=1
pkgdesc='GNU Emacs without X11, trimmed for terminal + vim-style use (no org/gnus/mail)'
arch=('x86_64')
url='https://www.gnu.org/software/emacs/emacs.html'
license=(GPL-3.0-or-later)

depends=(
  gmp
  gnutls
  hicolor-icon-theme
  libacl.so
  libgccjit
  libgpm.so
  libncursesw.so
  libsystemd.so
  libtree-sitter.so
  libxml2.so
  zlib
)
makedepends=(libgccjit)

# 注意：program-suffix 留空 → 二进制仍叫 emacs（provides/conflicts 官方 emacs-nox）。
# 若想与官方 emacs-nox 共存，加 --program-suffix=-minimal 并改 provides/conflicts。

source=(
  https://ftp.gnu.org/gnu/emacs/emacs-${pkgver}.tar.xz{,.sig}
  01_all_treesit-0.26.patch
  02_all_ts-query-pred.patch
)
b2sums=('9163ba6bfab1010a156c669ac085ad363545d73e3ffac21c710b14b618df61a4c6a80a50fd3fa81d852c2ccace5080e614b679606fa584e28509f99ad6196784'
        'SKIP'
        '6a4a556ff6e47234c34e6d9b47fd7b51b47f0b66a4a1e6672b604555d48275de7c06afd105b9c4abf9a34eb1fc2148178e97434b9ae92b0345137dc849d5895c'
        '6f54ca35f5703a248a3db3b39d9666ee28424cdb7240bd0c7a612f387e1cedf9142b6f5b54d00f11b63b97f28d18d763c47b664c36be00e7b07e17cb741712b1')
validpgpkeys=('17E90D521672C04631B1183EE78DAE0F3115E06B'  # Eli Zaretskii <eliz@gnu.org>
              'CEA1DE21AB108493CC9C65742E82323B8F4353EE') # Stefan Kangas <stefankangas@gmail.com>

prepare() {
  cd emacs-${pkgver}
  patch -Np1 < ../01_all_treesit-0.26.patch
  patch -Np1 < ../02_all_ts-query-pred.patch
}

build() {
  cd emacs-${pkgver}

  local _confflags=(
    --sysconfdir=/etc
    --prefix=/usr
    --libexecdir=/usr/lib
    --localstatedir=/var
    --disable-build-details
    --with-modules
    --with-native-compilation=aot
    --with-tree-sitter
    --without-x        # 终端用，砍掉整个 X11/GTK 栈
    --without-sound    # 终端无声卡
  )

  ./configure "${_confflags[@]}"
  make
}

package() {
  cd emacs-${pkgver}
  make DESTDIR="${pkgdir}" install

  # remove conflict with ctags package
  mv "${pkgdir}"/usr/bin/{ctags,ctags.emacs}
  mv "${pkgdir}"/usr/share/man/man1/{ctags.1.gz,ctags.emacs.1}

  # fix user/root permissions on usr/share files
  chown -R root:root "${pkgdir}/usr/share/emacs/${pkgver}"

  # ============================================================
  # 裁剪：configure 无法去掉这些纯 Elisp 目录，在此手动删。
  # 它们都是 autoload 按需加载 —— 删掉只省磁盘，不影响启动/核心编辑。
  # ============================================================
  local lisp="${pkgdir}/usr/share/emacs/${pkgver}/lisp"
  rm -rf "$lisp/gnus"      # 邮件/新闻阅读器
  rm -rf "$lisp/mh-e"      # mh 邮件
  rm -rf "$lisp/mail"      # 邮件底层
  rm -rf "$lisp/org"       # Org mode
  rm -rf "$lisp/erc"       # IRC 客户端
  rm -rf "$lisp/calc"      # 全功能计算器
  rm -rf "$lisp/cedet"     # 旧 IDE 引擎栈（已被 treesit+eglot 取代）
  rm -rf "$lisp/play"      # 内置游戏
  rm -rf "$lisp/obsolete"  # 已废弃模式
  rm -rf "$lisp/leim"      # 内置输入法(quail)+日文词典 17M
                          # 终端用 fcitx5 输入中文，从不碰 emacs quail。
                          # 中文文件读写不受影响（靠 international/language/charsets）。

  # etc 资源：终端用不到的图片/速查卡/教程/历史日志
  local etc="${pkgdir}/usr/share/emacs/${pkgver}/etc"
  rm -rf "$etc/images"
  rm -rf "$etc/refcards"
  rm -rf "$etc/tutorials"
  rm -f "$etc"/NEWS.*      # 老版本变更日志(NEWS.18~29 等)约 2M，纯文档

  # 注：不重建 loaddefs.el。删掉的 org/gnus 等目录在 loaddefs 里
  # 仍有 autoload 条目，但它们只在用户主动 M-x 对应命令时才触发加载，
  # 平时不会执行，也无启动开销（与官方 emacs-nox 行为一致）。
  # 重建反而会因 generated-autoload-file 是 lexical 变量而在 batch 下报错。
}
