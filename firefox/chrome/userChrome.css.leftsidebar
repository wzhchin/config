:root {
    --toolbar-item-height: 40px;
    --buttonbox-left-width: 0px;
    --sdbr-wdt: 300px;
    --left-margin: 40px;
    --cbg: #eee;
}

#browser {
    background: #eee !important;
}

#sidebar-header {
    display: none;
}

#sidebar-box {
    background: #eee !important;
    max-width: 320px !important;
    min-width: 320px !important;
    margin-top: 150px;
    transition: width 0.3s ease, opacity 0.3s ease 0.2s !important;
}

#sidebar-splitter {
    display: none !important;
}

#navigator-toolbox {
    z-index: 2 !important;  /* 3 spills extensions onto page*/
    max-height: 0px;
    transition: width 0.3s ease, opacity 0.3s ease 0.2s !important;
}

#TabsToolbar {
    visibility: collapse !important;
}

#TabsToolbar .tabbrowser-tab {
    display: none !important;
}

#nav-bar[inFullscreen],
#TabsToolbar[inFullscreen] {
    display: none;
}

#TabsToolbar > .titlebar-buttonbox-container {
    display: none !important;
}


#nav-bar,
#urlbar-container {
    background: #eee !important;
    width: 305px !important;
    left: 9px;
    transition: width 0.3s ease, opacity 0.3s ease 0.2s !important;
}

#tabbrowser-tabbox {
    outline: 0.01px solid light-dark(rgba(0,0,0,.3), rgba(255,255,255,.3));
    box-shadow: 0 2px 6px 0 light-dark(rgba(0,0,0,.2), rgba(0,0,0,.8));
    top: -1px;
    margin: -1px;
}

#PersonalToolbar {
    background: #eee !important;
    width: 320px !important;
}

#nav-bar {
    display: flex;
    box-shadow: none !important;
    border: none !important;
    position: absolute !important;
    top: 6px !important;
    overflow: visible !important;
    height: 40px !important;
}

#PersonalToolbar {
    top: 100px !important;
    position: fixed;
    transition: var(--transition) !important;

    & > * {
        transition: var(--transition) !important;
    }

    visibility: visible !important;
    height: var(--toolbar-item-height) !important;

    margin-left: var(--buttonbox-left-width);

    padding-top: 3px !important;
    padding-bottom: 3px !important;

    &[collapsed="true"] {
        display: none;
    }
}

#PlacesToolbarItems {
    display: flex !important;
}

.bookmark-item {
    flex: 1;
}

#customization-content-container {
    margin-left: 320px;
}

#customization-header {
    width: 100vw !important;
}
#urlbar-container {
    display: flex;
    position: absolute !important;
    left: -6px;
    height: 30px !important;
    top: 50px !important;
}


#urlbar-input {
    padding-left: 10px !important;
}


#urlbar #urlbar-background,
#urlbar,
#urlbar-input-container,
#searchbar,
.searchbar-textbox {
    box-shadow: none !important;
    font-size: 12px;
}

#tracking-protection-icon-container {
    display: none;
}

#sidebar-box[hidden] {
    display: flex !important;
    width: 0px !important;
    min-width: 0px !important;
    overflow: hidden !important;
    padding: 0 !important;
    opacity: 0 !important;
    transition: width 0.3s ease, padding 0.3s step-end, opacity 0.2s ease !important;
}

body:has(#sidebar-box[hidden]:not(:hover)) #navigator-toolbox {
    width: 0px !important;
    overflow: hidden !important;
    pointer-events: none;
    opacity: 0 !important;
    transition: width 0.3s ease, opacity 0.2s ease !important;
}

body:has(#sidebar-box[hidden]:not(:hover)) toolbaritem#urlbar-container {
    width: 0px !important;
    max-width: 0px !important;
    pointer-events: none;
}

body:has(#sidebar-box[hidden]) #urlbar {
    opacity: 0 !important;
    transition: opacity 0.2s ease !important;
}

#urlbar:is([focused][breakout-extend]) {
    width: 600px !important;
}

#urlbar:is([breakout-extend]) #tracking-protection-icon-container,
#tracking-protection-icon-container:has([open]) {
    transition: opacity 0.2s ease;
    position: relative !important;
    left: 0px;
    top: 50%;
    transform: translateY(-50%);
    opacity: 1;
}
