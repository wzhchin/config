#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'Usage: %s {start|snapshot|end} <change-slug> [snapshot description]\n' "${0##*/}" >&2
  exit 2
}

fail() {
  printf 'light-spec-commit: %s\n' "$1" >&2
  exit 1
}

(( $# >= 2 )) || usage
action=$1
slug=$2
shift 2

[[ "$slug" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail 'change slug must be lowercase kebab-case'

case "$action" in
  start|end)
    (( $# == 0 )) || usage
    ;;
  snapshot)
    ;;
  *) usage ;;
esac

project_root=$(git rev-parse --show-toplevel 2>/dev/null) || fail 'run inside a Git repository'
cd -- "$project_root"

now_dir=docs/changes/now
ended_dir=docs/changes/ended
[[ -d "$now_dir" ]] || fail "missing $now_dir"

shopt -s nullglob
matches=("$now_dir"/????-??-??-"$slug")
active_dirs=()
for path in "${matches[@]}"; do
  [[ -d "$path" && ${path##*/} =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-${slug}$ ]] \
    && active_dirs+=("$path")
done

(( ${#active_dirs[@]} == 1 )) || fail "expected exactly one active change for slug '$slug'; found ${#active_dirs[@]}"
active_dir=${active_dirs[0]}
proposal=$active_dir/proposal.md
[[ -f "$proposal" ]] || fail "missing $proposal"

abbr=
IFS='-' read -r -a slug_words <<<"$slug"
for word in "${slug_words[@]}"; do
  abbr+=${word:0:1}
done

case "$action" in
  start)
    [[ -n $(git status --porcelain --untracked-files=all -- "$proposal") ]] \
      || fail "proposal is not new or modified: $proposal"
    git add -- "$proposal"
    git commit --only -m "spec: $slug($abbr) start" -- "$proposal"
    ;;
  snapshot)
    if (( $# > 0 )); then
      description=$*
    else
      description=snapshot
    fi
    [[ -n "$description" ]] || fail 'snapshot description cannot be empty'
    if git diff --cached --quiet; then
      fail 'no staged changes to commit; stage the files for this snapshot first'
    fi
    git commit -m "$abbr: $description"
    ;;
  end)
    grep -Fxq 'Status: completed' "$proposal" \
      || fail "mark $proposal as Status: completed after verification before ending"
    [[ -d "$ended_dir" ]] || fail "missing $ended_dir"
    ended_path=$ended_dir/${active_dir##*/}
    [[ ! -e "$ended_path" ]] || fail "archive destination already exists: $ended_path"
    mv -- "$active_dir" "$ended_path"
    git add -A -- "$active_dir" "$ended_path"
    git commit --only -m "spec: $slug finished" -- "$active_dir" "$ended_path"
    ;;
esac
